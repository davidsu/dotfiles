#!/usr/bin/env python3
"""Model-free poller: new GitHub and Slack activity by given people → one teamup line each. See ../resources/watch_people.md."""
import argparse
import calendar
import functools
import html
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

SCRIPTS = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPTS.parent.parent / "suss-communication.ln" / "scripts"))
from slack_session import slack_api  # noqa: E402

TEAMUP = SCRIPTS / "teamup"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "suss-teamup" / "watch_people"
TEAMUP_ENV = {key: value for key, value in os.environ.items()
              if key not in {"CLAUDE_CODE_SESSION_ID", "TEAMUP_SESSION", "CODEX_THREAD_ID", "TEAMUP_SESSION_NAME"}}
THREAD_LOOKBACK_SECONDS = 14 * 86400
SEEN_RETENTION_SECONDS = 30 * 86400
GH_TIMEOUT_SECONDS = 60
SEARCH_LIMIT = 30
MAX_TEXT_CHARS = 200
DURATION_UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}


@dataclass
class Item:
    id: str
    at: float
    who: str
    what: str
    url: str

    def line(self) -> str:
        return f"{self.who} {self.what} {self.url}"


def seconds_of(duration: str) -> int:
    match = re.fullmatch(r"(\d+)([smhd])", duration)
    if not match:
        raise argparse.ArgumentTypeError(f"'{duration}' is not a duration like 10m or 24h")
    return int(match[1]) * DURATION_UNITS[match[2]]


def csv(value: str) -> list[str]:
    return [part for part in value.split(",") if part]


def log(message: str):
    print(f"{time.strftime('%F %T')} {message}", file=sys.stderr, flush=True)


def one_line(text: str) -> str:
    flat = " ".join(text.split())
    return flat if len(flat) <= MAX_TEXT_CHARS else flat[:MAX_TEXT_CHARS] + "…"


def epoch_of(iso: str) -> float:
    return calendar.timegm(time.strptime(iso, "%Y-%m-%dT%H:%M:%SZ"))


def gh_json(*args: str):
    return json.loads(subprocess.run(["gh", *args], capture_output=True, text=True, check=True,
                                     timeout=GH_TIMEOUT_SECONDS).stdout or "[]")


def gh_list(path: str) -> list[dict]:
    return [entry for page in gh_json("api", "--paginate", "--slurp", path) for entry in page]


def watched_prs(args) -> list[str]:
    if args.github_search:
        found = gh_json("search", "prs", "--sort", "updated", "--limit", str(SEARCH_LIMIT), "--json", "number,repository", "--", *shlex.split(args.github_search))
        return [f"{pr['repository']['nameWithOwner']}#{pr['number']}" for pr in found]
    return [pr if "#" in pr else f"{args.github_repo}#{pr}" for pr in args.github_prs]


def github_feedback(pr: str) -> list[tuple[dict, str, str]]:
    repo, number = pr.split("#")
    comments = gh_list(f"repos/{repo}/issues/{number}/comments?per_page=100")
    review_comments = gh_list(f"repos/{repo}/pulls/{number}/comments?per_page=100")
    reviews = [review for review in gh_list(f"repos/{repo}/pulls/{number}/reviews?per_page=100") if review.get("submitted_at")]
    return ([(comment, comment["created_at"], f"commented on {pr}") for comment in comments]
            + [(comment, comment["created_at"], f"commented on {pr} {comment['path']}") for comment in review_comments]
            + [(review, review["submitted_at"], f"reviewed {pr} [{review['state']}]") for review in reviews])


def github_merge(pr: str) -> list[Item]:
    repo, number = pr.split("#")
    pull = gh_json("api", f"repos/{repo}/pulls/{number}")
    if not pull.get("merged_at"):
        return []
    return [Item(f"merged:{pr}", epoch_of(pull["merged_at"]), pull["merged_by"]["login"],
                 f"merged {pr}: {one_line(pull['title'])}", pull["html_url"])]


def github_items(args, pr: str) -> list[Item]:
    users = {user.lower() for user in args.github_users}
    feedback = [Item(f"gh:{entry['id']}", epoch_of(at), entry["user"]["login"],
                     f"{what}: {one_line(entry.get('body') or '')}", entry["html_url"])
                for entry, at, what in github_feedback(pr) if entry["user"]["login"].lower() in users]
    return feedback + github_merge(pr)


@functools.cache
def slack_name(user: str) -> str:
    return slack_api("users.info", user=user)["user"]["real_name"]


@functools.cache
def slack_place(channel: str) -> str:
    info = slack_api("conversations.info", channel=channel)["channel"]
    return f"DM with {slack_name(info['user'])}" if info.get("is_im") else f"#{info['name']}"


def slack_author(message: dict) -> str:
    return slack_name(message["user"]) if message.get("user") else message.get("username") or message.get("bot_profile", {}).get("name", "bot")


def slack_text(message: dict) -> str:
    attachment_text = " · ".join(part for attachment in message.get("attachments", [])
                                 for part in (attachment.get("pretext"), attachment.get("title"), attachment.get("text")) if part)
    return html.unescape(message.get("text") or attachment_text)


def slack_ts(epoch: float) -> str:
    return f"{epoch:.6f}"


def slack_pages(method: str, **fields) -> list[dict]:
    messages, cursor = [], ""
    while True:
        page = slack_api(method, limit="200", **fields, **({"cursor": cursor} if cursor else {}))
        messages += page["messages"]
        cursor = page.get("response_metadata", {}).get("next_cursor")
        if not cursor:
            return messages


def slack_messages(channel: str, since: float) -> list[dict]:
    parents = slack_pages("conversations.history", channel=channel, oldest=slack_ts(time.time() - THREAD_LOOKBACK_SECONDS))
    active_threads = [parent["ts"] for parent in parents if float(parent.get("latest_reply", 0)) > since]
    replies = [reply for thread in active_threads
               for reply in slack_pages("conversations.replies", channel=channel, ts=thread, oldest=slack_ts(since))]
    return parents + replies


def slack_item(channel: str, message: dict) -> Item:
    is_reply = message.get("thread_ts", message["ts"]) != message["ts"]
    what = f"{'replied in a thread' if is_reply else 'wrote'} in {slack_place(channel)}: {one_line(slack_text(message))}"
    url = slack_api("chat.getPermalink", channel=channel, message_ts=message["ts"])["permalink"]
    return Item(f"slack:{channel}:{message['ts']}", float(message["ts"]), slack_author(message), what, url)


def slack_items(args, channel: str, is_new) -> list[Item]:
    is_feed = channel in args.slack_feeds
    return [slack_item(channel, message) for message in slack_messages(channel, is_new.since)
            if (is_feed or message.get("user") in args.slack_users) and is_new(f"slack:{channel}:{message['ts']}", float(message["ts"]))]


def github_sources(args) -> list:
    try:
        return [functools.partial(github_items, args, pr) for pr in watched_prs(args)]
    except Exception as err:
        log(f"listing PRs failed this period: {err!r}")
        return []


def sources(args, is_new) -> list:
    slack = [functools.partial(slack_items, args, channel, is_new) for channel in args.slack_channels + args.slack_feeds]
    return github_sources(args) + slack


def items_of(source, is_new) -> list[Item]:
    try:
        return [item for item in source() if is_new(item.id, item.at)]
    except Exception as err:
        log(f"skipped {source.args[1]} this period: {err!r}")
        return []


def new_items(args, is_new) -> list[Item]:
    items = [item for source in sources(args, is_new) for item in items_of(source, is_new)]
    return sorted({item.id: item for item in items}.values(), key=lambda item: item.at)


class Seen:
    def __init__(self, path: Path | None, since: float | None):
        state = json.loads(path.read_text()) if path and path.exists() else {}
        self.path, self.ids = path, state.get("seen", {})
        self.since = since or state.get("since") or time.time()

    def __call__(self, item_id: str, at: float) -> bool:
        return item_id not in self.ids and at > max(self.since, time.time() - SEEN_RETENTION_SECONDS)

    def add(self, item: Item):
        self.ids = {item_id: at for item_id, at in self.ids.items() if at > time.time() - SEEN_RETENTION_SECONDS} | {item.id: item.at}
        if self.path:
            self.path.write_text(json.dumps({"since": self.since, "seen": self.ids}))


def teamup(*args: str, check: bool = True):
    return subprocess.run([str(TEAMUP), *args], env={**TEAMUP_ENV, "TEAMUP_SLACK": "off"},
                          capture_output=True, text=True, check=check)


def post(args, item: Item) -> bool:
    teamup("recv", args.channel, "--as", args.handle, "--discard")
    said = teamup("say", args.channel, "--as", args.handle, "--", f"@{args.to} {item.line()}" if args.to else item.line(), check=False)
    if said.returncode:
        log(f"say refused ({said.returncode}): {said.stdout.strip()} {said.stderr.strip()}")
    return said.returncode == 0


def join(args) -> bool:
    throwaway = ["--throwaway"] if args.throwaway else []
    joined = teamup("join", args.channel, "--as", args.handle, "--pwd", "watch_people", *throwaway, "--doing",
                    f"posting new activity by {', '.join(args.github_users + args.slack_users) or 'feeds'}", check=False)
    if joined.returncode:
        log(f"join failed ({joined.returncode}), retrying next period: {joined.stdout.strip()} {joined.stderr.strip()}")
    return joined.returncode == 0


def stop_on_sigterm():
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))


def post_new_items(args, seen: Seen):
    for item in new_items(args, seen):
        if post(args, item):
            seen.add(item)


def run_period(args, seen: Seen, is_joined: bool) -> bool:
    try:
        is_joined = is_joined or join(args)
        if is_joined:
            post_new_items(args, seen)
    except Exception as err:
        log(f"period failed, retrying next period: {err!r}")
    return is_joined


def poll_forever(args, seen: Seen):
    is_joined = False
    try:
        while True:
            is_joined = run_period(args, seen, is_joined)
            time.sleep(args.poll_period)
    finally:
        teamup("leave", args.channel, "--as", args.handle, check=False)


def print_dry_run(args):
    for item in new_items(args, Seen(None, time.time() - args.since)):
        print(item.line())


def parse_args():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--channel", required=True)
    parser.add_argument("--as", dest="handle", default="people.watch")
    parser.add_argument("--to", help="handle to @-address so its listener wakes")
    parser.add_argument("--github-users", type=csv, default=[])
    parser.add_argument("--github-prs", type=csv, default=[])
    parser.add_argument("--github-repo", default="base44-dev/apper")
    parser.add_argument("--github-search")
    parser.add_argument("--slack-users", type=csv, default=[])
    parser.add_argument("--slack-channels", type=csv, default=[])
    parser.add_argument("--slack-feeds", type=csv, default=[], help="channels where every message counts, whoever wrote it")
    parser.add_argument("--poll-period", type=seconds_of, default="10m")
    parser.add_argument("--since", type=seconds_of, help="look back this far (default: since the state file was created)")
    parser.add_argument("--state", type=Path)
    parser.add_argument("--throwaway", action="store_true")
    parser.add_argument("--dry-run", action="store_true", help="print one period's lines (needs --since), post nothing")
    return parser.parse_args()


def main():
    args = parse_args()
    if args.dry_run:
        return print_dry_run(args)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    stop_on_sigterm()
    since = time.time() - args.since if args.since else None
    poll_forever(args, Seen(args.state or STATE_DIR / f"{args.channel}.{args.handle}.json", since))


if __name__ == "__main__":
    main()
