#!/usr/bin/env -S python3 -I
"""teamup-telegram setup <bot> | on <subject> --bot <bot> | off <subject> | status | auto

Relays teamup channels to David's chats with his Telegram bots, and his replies back as 'david'.
Each relayed channel is bound to one bot; each bot is its own Telegram chat. Agent lines tagged
[top] or naming @david go out on the channel's bot as '<subject> · <handle>: text'. A Telegram
reply to one of them lands on that subject as 're #<seq> …', which wakes its author; any other
message lands on the bot's channel that last spoke. Chats other than David's are dropped.
Each bot's token lives in the login keychain (service suss-telegram, account = bot name); its chat
id and David's user id live in ~/.local/share/suss-teamup/telegram.json. `setup <bot>` reads a new
bot's token on stdin, waits for his /start
and records the chat id. The daemon tails channel.tsv with its own cursor and never joins, so it
is not a peer for anyone's wake rules. Every `teamup join` runs `auto`, which restarts the daemon
when channels are relayed but it is down (after a reboot).
"""
import functools
import html
import json
import os
import queue
import re
import signal
import subprocess
import sys
import threading
import time
import urllib.request
import uuid
from pathlib import Path

HERE = Path(__file__).resolve().parent
TEAMUP = HERE / "teamup"
BASE = Path(os.environ.get("SUSS_TEAMUP_DIR", "/tmp/suss-teamup"))
CONFIG = Path.home() / ".local/share/suss-teamup/telegram.json"
KEYCHAIN_SERVICE = "suss-telegram"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "suss-teamup/telegram"
CHANNELS = STATE / "channels.json"
LAST_RELAY = STATE / "last_relay"
PID = STATE / "daemon.pid"
LOG = STATE / "daemon.log"
MEDIA = STATE / "media"
WHISPER_MODEL = Path.home() / ".local/share/whisper/ggml-medium.bin"
ATTACHMENT_KINDS = ("photo", "voice", "audio", "video_note", "video", "document")
SPOKEN_ATTACHMENTS = ("voice", "audio", "video_note")
HUMAN = "david"
TOP_LEVEL_TAG = " [top]"
SPOKEN = ("say", "ask", "ack")
LONG_POLL_SECONDS = 10
SETUP_POLL_SECONDS = 30
SOCKET_SLACK_SECONDS = 5
SEND_TIMEOUT_SECONDS = 15
WATCH_INTERVAL_SECONDS = 0.3
RETRY_DELAY_SECONDS = 1
CHANNEL_CHECK_SECONDS = 5
MAX_ROUTES = 500
MAX_TEXT_CHARS = 4000
FILE_MARKER = re.compile(r"\[file: ([^\]]+)\]")
LINE_BREAK = "\\n"
COPY_TAG = "[copy] "
LONG_PARAGRAPH_CHARS = 160
NUMBERED_ITEM = re.compile(r"\s+(?=\(\d+\)\s)")
SENTENCE_BREAK = re.compile(r"(?<=[.!?:])\s+(?=\S)")
POST_ENV = {**{key: value for key, value in os.environ.items()
               if key not in ("CLAUDE_CODE_SESSION_ID", "TEAMUP_SESSION", "CODEX_THREAD_ID", "TEAMUP_SESSION_NAME")},
            "TEAMUP_SLACK": "off"}


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write_json(path, value):
    temporary = path.with_name(f".{path.name}.{threading.get_ident()}")
    temporary.write_text(json.dumps(value, ensure_ascii=False))
    temporary.replace(path)


def log(text):
    print(f"{time.strftime('%F %T')} {text}", flush=True)


def bots(): return read_json(CONFIG, {}).get("bots", {})


def chat_of(bot): return bots()[bot]["chat_id"]


def david_id(): return read_json(CONFIG, {})["david_id"]


def relayed_channels(): return read_json(CHANNELS, {})


def subjects_of(bot): return [subject for subject, owner in relayed_channels().items() if owner == bot]


def offset_file(bot): return STATE / f"{bot}.offset"


def routes_file(bot): return STATE / f"{bot}.routes.json"


def last_bot_file(chat_id): return STATE / f"{chat_id}.last_bot"


@functools.cache
def token_of(bot):
    return subprocess.run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", bot, "-w"],
                          capture_output=True, text=True, check=True).stdout.strip()


def store_token(bot, token):
    command = f"add-generic-password -U -s {KEYCHAIN_SERVICE} -a {bot} -w {token}\n"
    subprocess.run(["security", "-i"], input=command, capture_output=True, text=True, check=True)


def has_token(bot):
    return subprocess.run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", bot],
                          capture_output=True).returncode == 0


def bot_user_id(bot): return int(token_of(bot).split(":")[0])


def bots_in(chat_id): return sorted(bot for bot, config in bots().items() if config.get("chat_id") == chat_id)


def bot_url(bot, method): return f"https://api.telegram.org/bot{token_of(bot)}/{method}"


def call_bot(request, socket_timeout=SEND_TIMEOUT_SECONDS):
    with urllib.request.urlopen(request, timeout=socket_timeout) as response:
        return json.load(response)["result"]


def telegram(bot, method, socket_timeout=SEND_TIMEOUT_SECONDS, **params):
    return call_bot(urllib.request.Request(bot_url(bot, method), data=json.dumps(params).encode(),
                                           headers={"Content-Type": "application/json"}), socket_timeout)


def form_field(boundary, name, value, filename=None):
    disposition = f'form-data; name="{name}"' + (f'; filename="{filename}"' if filename else "")
    return f"--{boundary}\r\nContent-Disposition: {disposition}\r\n\r\n".encode() + value + b"\r\n"


def send_document(bot, path):
    boundary = uuid.uuid4().hex
    body = (form_field(boundary, "chat_id", str(chat_of(bot)).encode())
            + form_field(boundary, "document", path.read_bytes(), path.name) + f"--{boundary}--\r\n".encode())
    return call_bot(urllib.request.Request(bot_url(bot, "sendDocument"), data=body,
                                           headers={"Content-Type": f"multipart/form-data; boundary={boundary}"}))


def fetch_updates(bot, timeout):
    updates = telegram(bot, "getUpdates", socket_timeout=timeout + SOCKET_SLACK_SECONDS,
                       offset=int(read_json(offset_file(bot), 0)), timeout=timeout, allowed_updates=["message"])
    if updates:
        write_json(offset_file(bot), updates[-1]["update_id"] + 1)
    return [update["message"] for update in updates if "message" in update]


def channel_lines(subject):
    try:
        return (BASE / subject / "channel.tsv").read_text().splitlines()
    except OSError:
        return []


def is_for_david(handle, kind, body):
    return handle != HUMAN and kind in SPOKEN and (body.endswith(TOP_LEVEL_TAG) or f"@{HUMAN}" in body)


def messages_for_david(lines, cursor):
    for seq, line in enumerate(lines[cursor:], start=cursor + 1):
        _, handle, kind, body = (line.split("\t", 3) + [""] * 4)[:4]
        if is_for_david(handle, kind, body):
            yield seq, handle, body.removesuffix(TOP_LEVEL_TAG)


def send_file(bot, path):
    try:
        send_document(bot, path)
    except (OSError, ValueError) as error:
        telegram(bot, "sendMessage", chat_id=chat_of(bot), text=f"(file not sent: {path}: {error})")


def send_files(bot, body):
    for path in map(Path, FILE_MARKER.findall(body)):
        send_file(bot, path)


def readable(body):
    return body.replace(f"@{HUMAN} ", "", 1).replace(LINE_BREAK, "\n")


def lines_of(paragraph):
    return SENTENCE_BREAK.sub("\n", paragraph) if len(paragraph) > LONG_PARAGRAPH_CHARS else paragraph


def airy(text):
    paragraphs = NUMBERED_ITEM.sub("\n\n", text).split("\n\n")
    return "\n\n".join(lines_of(paragraph.strip()) for paragraph in paragraphs)


def agents_on(subject):
    members = BASE / subject / "members"
    return {member.name for member in members.iterdir() if member.name != HUMAN} if members.is_dir() else set()


def agents_in_chat(chat_id):
    return set().union(*(agents_on(subject) for subject, bot in relayed_channels().items() if bot in bots_in(chat_id)))


def message_html(subject, handle, body, is_signed):
    text = readable(body)
    if text.startswith(COPY_TAG):
        return html.escape(text.removeprefix(COPY_TAG)[:MAX_TEXT_CHARS])
    signature = f"\n\n<b><i>agent: {html.escape(handle)}</i></b>" if is_signed else ""
    return f"<i>{html.escape(subject)}</i>\n\n{html.escape(airy(text)[:MAX_TEXT_CHARS])}{signature}"


def remember_route(bot, message_id, subject, seq):
    routes = read_json(routes_file(bot), {})
    routes[str(message_id)] = {"subject": subject, "seq": seq}
    write_json(routes_file(bot), dict(list(routes.items())[-MAX_ROUTES:]))


def forward(bot, subject, seq, handle, body):
    chat_id = chat_of(bot)
    text = message_html(subject, handle, body, is_signed=len(agents_in_chat(chat_id)) > 1)
    sent = telegram(bot, "sendMessage", chat_id=chat_id, text=text, parse_mode="HTML")
    write_json(last_bot_file(chat_id), bot)
    send_files(bot, body)
    remember_route(bot, sent["message_id"], subject, seq)
    record_relay("out", subject)


RELAY_LOCK = threading.Lock()


def record_relay(direction, subject):
    with RELAY_LOCK:
        write_json(LAST_RELAY, {**read_json(LAST_RELAY, {}), direction: f"{time.strftime('%F %T')} {subject}"})


def cursor_file(subject): return STATE / f"{subject}.cursor"


def cursor_within(lines, subject):
    cursor = read_json(cursor_file(subject), 0)
    return cursor if cursor <= len(lines) else 0


def forward_new_lines():
    for subject, bot in relayed_channels().items():
        lines = channel_lines(subject)
        for seq, handle, body in messages_for_david(lines, cursor_within(lines, subject)):
            forward(bot, subject, seq, handle, body)
            write_json(cursor_file(subject), seq)
        write_json(cursor_file(subject), len(lines))


def route_of(bot, message):
    routes = read_json(routes_file(bot), {})
    replied_to = str(message.get("reply_to_message", {}).get("message_id", ""))
    if route := routes.get(replied_to):
        return route["subject"], f"re #{route['seq']} "
    subjects = subjects_of(bot)
    spoken_last = [route["subject"] for route in routes.values() if route["subject"] in subjects]
    return (spoken_last[-1:] or subjects[:1] or [None])[0], ""


def attachment_of(message):
    kind = next((kind for kind in ATTACHMENT_KINDS if kind in message), None)
    if kind is None:
        return None, None
    file = message[kind][-1] if kind == "photo" else message[kind]
    return kind, file["file_id"]


def download(bot, file_id, message_id):
    remote_path = telegram(bot, "getFile", file_id=file_id)["file_path"]
    MEDIA.mkdir(parents=True, exist_ok=True)
    local_path = MEDIA / f"{bot}_{message_id}_{Path(remote_path).name}"
    urllib.request.urlretrieve(f"https://api.telegram.org/file/bot{token_of(bot)}/{remote_path}", local_path)
    return local_path


def transcribe(audio_path):
    wav_path = audio_path.with_suffix(".wav")
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(audio_path), "-ar", "16000", "-ac", "1", str(wav_path)],
                   check=True)
    whisper = subprocess.run(["whisper-cli", "-m", str(WHISPER_MODEL), "-l", "auto", "-nt", "-np", "-f", str(wav_path)],
                             capture_output=True, text=True)
    return whisper.stdout.strip() or f"(transcription failed: {whisper.stderr.strip()[-200:]})"


def text_of(bot, message):
    kind, file_id = attachment_of(message)
    words = message.get("text") or message.get("caption") or ""
    if kind is None:
        return words
    saved = download(bot, file_id, message["message_id"])
    transcript = f" transcript: {transcribe(saved)}" if kind in SPOKEN_ATTACHMENTS else ""
    return f"{words} [{kind}: {saved}]{transcript}".strip().replace("\n", " ")


def deliver_reply(bot, message):
    subject, prefix = route_of(bot, message)
    if subject is None:
        return telegram(bot, "sendMessage", chat_id=message["chat"]["id"], text="No teamup channel is relayed here right now.")
    posted = subprocess.run([str(TEAMUP), "say", subject, "--as", HUMAN, "--", prefix + text_of(bot, message)],
                            env=POST_ENV, capture_output=True, text=True)
    reaction = "👍" if posted.returncode == 0 else "👎"
    telegram(bot, "setMessageReaction", chat_id=message["chat"]["id"], message_id=message["message_id"],
             reaction=[{"type": "emoji", "emoji": reaction}])
    record_relay("in", subject)


def is_from_david(bot, message):
    return message["chat"]["id"] == chat_of(bot) and message.get("from", {}).get("id") == david_id()


def bot_spoken_last_in(chat_id):
    return read_json(last_bot_file(chat_id), None) or next(iter(bots_in(chat_id)), None)


def is_addressed_to(bot, message):
    replied_to = message.get("reply_to_message", {}).get("from", {})
    if replied_to.get("is_bot"):
        return replied_to["id"] == bot_user_id(bot)
    return bot_spoken_last_in(message["chat"]["id"]) == bot


def route_message(bot, message):
    if not is_from_david(bot, message):
        log(f"{bot}: dropped a message from chat {message['chat']['id']}")
    elif is_addressed_to(bot, message):
        deliver_reply(bot, message)


def run_guarded(step, *args):
    try:
        step(*args)
        return True
    except TimeoutError:
        log(f"{step.__name__} timed out, retrying")
    except Exception as error:
        log(f"{step.__name__} failed: {error!r}")
        time.sleep(RETRY_DELAY_SECONDS)
    return False


def channel_stamp(subject):
    try:
        stat = (BASE / subject / "channel.tsv").stat()
        return stat.st_mtime_ns, stat.st_size
    except OSError:
        return None


def forward_forever():
    seen = None
    while True:
        stamps = {subject: channel_stamp(subject) for subject in relayed_channels()}
        if stamps != seen and run_guarded(forward_new_lines):
            seen = stamps
        time.sleep(WATCH_INTERVAL_SECONDS)


def queue_messages(bot, deliveries):
    for message in fetch_updates(bot, LONG_POLL_SECONDS):
        deliveries.put((bot, message))


def receive_forever(bot, deliveries):
    while True:
        run_guarded(queue_messages, bot, deliveries)


def deliver_forever(deliveries):
    while True:
        run_guarded(route_message, *deliveries.get())


def start_thread(loop, *args):
    threading.Thread(target=loop, args=args, daemon=True).start()


def run_daemon():
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    log("daemon up")
    deliveries = queue.Queue()
    start_thread(forward_forever)
    start_thread(deliver_forever, deliveries)
    receiving = set()
    while channels := relayed_channels():
        for bot in set(channels.values()) - receiving:
            start_thread(receive_forever, bot, deliveries)
            receiving.add(bot)
        time.sleep(CHANNEL_CHECK_SECONDS)
    log("no channels left, daemon down")


def daemon_pid():
    try:
        pid = int(PID.read_text())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def start_daemon():
    if daemon_pid():
        return
    with open(LOG, "a") as log_file:
        process = subprocess.Popen([sys.executable, "-I", __file__, "__run"], stdout=log_file, stderr=log_file,
                                   stdin=subprocess.DEVNULL, start_new_session=True)
    PID.write_text(str(process.pid))


def save_david(user_id):
    write_json(CONFIG, {**read_json(CONFIG, {}), "david_id": user_id})


def save_bot(bot, **fields):
    config = read_json(CONFIG, {})
    config["bots"] = {**config.get("bots", {}), bot: {**config.get("bots", {}).get(bot, {}), **fields}}
    write_json(CONFIG, config)
    CONFIG.chmod(0o600)


def token_from_stdin():
    print("Paste the bot token from @BotFather on stdin:", file=sys.stderr, flush=True)
    return sys.stdin.readline().strip()


def is_start(message):
    return message.get("text", "").split("@")[0] == "/start"


def start_messages(bot):
    try:
        return [message for message in fetch_updates(bot, SETUP_POLL_SECONDS) if is_start(message)]
    except TimeoutError:
        return []


def setup(bot):
    if not has_token(bot):
        store_token(bot, token_from_stdin())
        save_bot(bot)
    print(f"Send /start to bot '{bot}' in its chat or group; waiting…", flush=True)
    while not (starts := start_messages(bot)):
        pass
    chat = starts[0]["chat"]
    save_david(starts[0]["from"]["id"])
    save_bot(bot, chat_id=chat["id"])
    telegram(bot, "sendMessage", chat_id=chat["id"], text="Linked: teamup channels relayed on this bot will reach you here.")
    print(f"linked bot '{bot}' to chat '{chat.get('title') or chat.get('first_name', '')}' ({chat['type']}).")


def turn_on(subject, bot):
    if "chat_id" not in bots().get(bot, {}):
        sys.exit(f"bot '{bot}' is not set up; run: teamup-telegram setup {bot}")
    write_json(cursor_file(subject), len(channel_lines(subject)))
    write_json(CHANNELS, {**relayed_channels(), subject: bot})
    start_daemon()
    print(f"relaying '{subject}' to Telegram bot '{bot}' (daemon pid {daemon_pid()}); log: {LOG}")


def turn_off(subject):
    channels = {name: bot for name, bot in relayed_channels().items() if name != subject}
    write_json(CHANNELS, channels)
    if not channels and (pid := daemon_pid()):
        os.kill(pid, signal.SIGTERM)
    print(f"stopped relaying '{subject}'.")


def print_status():
    pid = daemon_pid()
    print(f"  daemon: {f'running (pid {pid})' if pid else 'stopped'}; last relay: {read_json(LAST_RELAY, {})}")
    print(f"  bots: {', '.join(bots()) or 'none'}")
    for subject, bot in relayed_channels().items():
        print(f"  {subject} → {bot}")


USAGE = __doc__.strip().splitlines()[0]

if __name__ == "__main__":
    STATE.mkdir(parents=True, exist_ok=True)
    command, args = (sys.argv[1] if len(sys.argv) > 1 else ""), sys.argv[2:]
    if command == "setup" and len(args) == 1:
        setup(*args)
    elif command == "on" and len(args) == 3 and args[1] == "--bot":
        turn_on(args[0], args[2])
    elif command == "off" and len(args) == 1:
        turn_off(*args)
    elif command == "status" and not args:
        print_status()
    elif command == "auto" and not args:
        if relayed_channels():
            start_daemon()
    elif command == "__run":
        run_daemon()
    else:
        sys.exit(f"usage: {USAGE}")
