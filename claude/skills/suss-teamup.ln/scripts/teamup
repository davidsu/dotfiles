#!/usr/bin/env bash
# teamup — a tiny file-based message channel so two or more agents can coordinate.
#
# Storage (no daemon, no deps):
#   $SUSS_TEAMUP_DIR/{subject}/
#     channel.tsv          append-only log: ts \t from \t type \t body   (one line/msg)
#     members/{handle}     presence file: pwd / doing / joined
#     .cursor.{handle}     last line number this handle has read
#     .wait.{handle}       pid of the armed idle listener (the Stop hook's liveness marker)
#     .woken.{handle}      highest seq a wait has already woken this handle for
#
# Each message has a stable id = its 1-based line number in channel.tsv ("seq").
# recv/peek/wait/join print it as "#<seq>" so any agent can ack a specific
# message by id. Message types: ping (join/leave noise), say (chatter),
# ask (a question targeted with @handle), ack (clears a pending ask), bye.
#
# Identity is explicit and stateless: pass --as {handle} on every call.
# Appends are atomic (O_APPEND); presence is one file per handle — no lock needed.
#
# Output is a plain mailbox protocol any agent (Codex/Gemini/Claude) can read:
# key=value summary lines and "#seq [time] handle (type) body" message lines.
#
# KNOWN ISSUE — "agents forget they're on a channel" (2026-06-22)
#   Symptom: an agent joins, goes heads-down on its own work, and never sees
#   peers' later messages. Peer messages pile up unread; rosters go stale because
#   agents stop without saying `bye`. Root cause is NOT the poll interval — it's
#   the WAKE LIFECYCLE: the only listener is a `wait` an agent launches in the
#   background, it used to die after 110s, and it had to be manually re-armed
#   (which agents drop). A finished background command also only re-invokes the
#   agent BETWEEN turns — it can't interrupt a turn in progress.
#
#   Script-only mitigation taken here (best-effort, may not fully solve it):
#     - `wait --timeout 0` blocks indefinitely, so one armed background watcher
#       survives a whole work-turn and reliably re-invokes the agent on the next
#       real message instead of dying on a timer.
#     - When `fswatch` is present it replaces the busy `sleep 2` poll, so a
#       long-lived watcher costs nothing until the channel actually changes.
#   Durable fix (implemented for claude-code) — `scripts/teamup-hook`:
#     - join/leave persist a cwd -> (subject, handle) map in $BASE/.sessions.tsv
#       (a Stop hook only learns the session's cwd, never the handle).
#     - `teamup-hook stop` blocks the stop (exit 2) while any of this cwd's
#       channels has UNREAD messages, forcing a `recv` before the agent yields.
#       It blocks on unread only — `recv` always clears unread, so it can't loop;
#       an unanswered-but-read ask does not re-block (that would trap a session).
#     - `teamup-hook session-end` auto-`leave`s this cwd's channels.
#   Wire it per harness. claude-code: ~/.claude/settings.json Stop + SessionEnd.
#   Other harnesses (e.g. pi) need their own wiring; the script is harness-neutral
#   as long as the lifecycle event delivers the session cwd as JSON `.cwd` on stdin.
#
# FIXED — "the channel woke me for nothing" (2026-08-04)
#   Symptom: agents kept being re-invoked by a finished background `wait`, ran
#   `recv`, and found unread=0. Cause: the harness's only wake signal is "the
#   background process exited", so EVERY exit read as a message — and `wait` had
#   three exits that were not messages: (a) a duplicate arm printed "already
#   listening" and exited 0 at once, which the Stop hook's --require-listener then
#   turned into a per-turn loop (arm blindly -> no-op exit -> wake -> arm again);
#   (b) a peer's join/leave ping counted as "someone spoke"; (c) an agent's own
#   guard wrapper around the arm exited after detaching. The invariant now enforced
#   in `wait` below: a wait exits only when something has happened on the channel
#   that this handle has not already seen. Duplicate idle arms stand by instead of
#   exiting, `leave` kills its listener, and `.woken.{handle}` stops a re-armed wait
#   from re-firing on the message that just woke the agent. A presence ping still
#   WAKES (it is the only tie-breaker when two agents idle waiting for each other)
#   but no longer counts as UNREAD anywhere — two questions that had been merged.
#   Residual (harness-inherent, cannot be fixed here): a message that lands mid-turn
#   fires the wait immediately, but the completion only reaches the agent after the
#   turn ends — so if the agent recv'd it at a checkpoint in between, that wake
#   arrives with nothing left to read. Always `recv` before believing a wake.

# FIXED — "the agent burned six turns waiting for a quiet channel" (2026-08-12)
#   Symptom: a pi agent looping say -> `wait --timeout 600` -> "still quiet, re-arming"
#   -> `wait` ..., a turn per lap, reaching nobody. Cause: §4's arm-and-re-arm protocol
#   is claude-code's (a background wait IS its only wake signal); on pi the extension's
#   fs.watch owns the wake, so the right move there is to END THE TURN. The docs said pi
#   "needs no armed wait" — permission, not prohibition — so agents kept polling.
#   Guard here (harness-neutral): a bounded wait that expires twice with the channel
#   UNCHANGED in between is that loop, so the second expiry says STOP LOOPING and names
#   the way to go idle on this harness. Any traffic in between (a peer's, or the agent's
#   own) resets it, so a real huddle is never scolded. pi's extension separately blocks
#   `wait --timeout 0` outright — nothing to arm there.

set -eo pipefail

readonly BASE="${SUSS_TEAMUP_DIR:-/tmp/suss-teamup}"
readonly DEFAULT_WAIT=110   # seconds; stays under the default 120s Bash budget
readonly CLAUDE_SESSIONS="$HOME/.claude/sessions"
readonly STANDBY_POLL=2      # seconds between ownership re-checks by a standby listener
readonly CONFIRM_DELAY=1     # seconds an idle listener defers to a foreground reader before firing

die() { echo "teamup: $*" >&2; exit 1; }

usage_text() {
  cat <<'EOF'
usage:
  teamup join   <subject> [--as <handle>] [--pwd <path>] [--doing <text>]  # --as defaults to this session's name
  teamup rename --as <handle> --to <new>                  # re-key your identity on every channel you're on (after a rename)
  teamup session-name [--session <guid>]                  # the handle this session's name implies; exit 1 if it has no chosen name
  teamup name-command                                     # what the USER types to name this session (/rename on claude, /banner on pi)
  teamup say    <subject> --as <handle> <message...>      (alias: send)
  teamup ask    <subject> --as <handle> [--to <handle>] <question...>  # a question that needs an answer
  teamup ack    <subject> --as <handle> [--re <seq>] [note...]         # answer/clear an ask (default: latest peer msg)
  teamup recv   <subject> --as <handle>                   # new msgs from others + summary line, non-blocking
  teamup status <subject> --as <handle>                   # summary only; exit 0=clean 1=unread 2=ask-for-me (cursor untouched)
  teamup status --as <handle>                             # no subject: list every team this handle is on + member count
  teamup teams  --session <guid> [--pwd <path>]           # compact one-line joined channels for a statusline (! ask, * unread)
  teamup wait   <subject> --as <handle> [--timeout <sec>] # block until someone speaks (default 110s; 0 = forever, for background idle waits)
                                                          # exits 0 only with something unread to read, 1 on timeout; a duplicate --timeout 0 stands by instead of exiting
  teamup roster <subject>                                 # who is on the channel
  teamup peek   <subject> [--last <n>]                    # show recent history (default 20)
  teamup leave  <subject> --as <handle>
  teamup leave  --all     --as <handle>                   # leave every channel this handle is on
  teamup erase  <subject> [--force]                       # delete a channel + its registry rows (refuses if members remain unless --force)
  teamup channels                                         # list active subjects
  teamup help                                             # print this help and exit 0 (aliases: -h, --help)
EOF
}

usage() { usage_text >&2; exit 2; }

now()   { date -u +%Y-%m-%dT%H:%M:%SZ; }
chan()  { printf '%s/%s/channel.tsv' "$BASE" "$1"; }
mdir()  { printf '%s/%s/members' "$BASE" "$1"; }
cursor(){ printf '%s/%s/.cursor.%s' "$BASE" "$1" "$2"; }
waitpid(){ printf '%s/%s/.wait.%s' "$BASE" "$1" "$2"; }   # live-listener pidfile
woken(){ printf '%s/%s/.woken.%s' "$BASE" "$1" "$2"; }    # highest seq a wait has already fired on
expiry(){ printf '%s/%s/.expiry.%s' "$BASE" "$1" "$2"; }  # channel size when this handle's last bounded wait expired

# A map so a lifecycle hook can find which channels THIS session joined. One TSV
# row per join: cwd \t subject \t handle \t session_guid. The hook keys on the
# session GUID — collision-free even when several agents share a cwd. The GUID
# comes from $TEAMUP_SESSION (a harness wrapper, e.g. the pi extension, sets it),
# $CLAUDE_CODE_SESSION_ID (claude-code sets it natively), or $CODEX_THREAD_ID
# (codex sets it in the agent's shell); empty if none, in which case the hook
# falls back to cwd. Concurrent join/leave races are "last writer wins" — a lost
# row only skips that channel until the next re-join.
sessions_file() { printf '%s/.sessions.tsv' "$BASE"; }
session_guid()  { printf '%s' "${TEAMUP_SESSION:-${CLAUDE_CODE_SESSION_ID:-${CODEX_THREAD_ID:-}}}"; }

# A handle is a filename, so fold anything a session name may legally contain
# (spaces, slashes) into dashes.
as_handle() { printf '%s' "$1" | tr -c 'A-Za-z0-9._+-' '-' | sed 's/--*/-/g; s/^-//; s/-$//'; }

# What the USER types to (re)name this session — the name a handle is derived from, and
# the only one they can see on screen. A harness whose naming command isn't claude's
# `/rename` exports its own: pi's teamup extension exports `/banner`, which sets the
# banner widget and the session name together.
name_session_command() { printf '%s' "${TEAMUP_NAME_COMMAND:-/rename}"; }

# The name the USER chose for this session — never a machine-derived one, which is
# noise rather than identity.
# A harness that can tell the agent's shell its session name just exports it (pi's
# teamup extension does, from whatever `/banner` or `pi -n` set; an unnamed pi session
# reports nothing at all, so this stays empty rather than guessing).
# claude-code instead keeps a live file per session: a chosen name has no nameSource,
# a machine-derived one is tagged "derived". A harness with neither gets nothing back.
chosen_session_name() { # session-guid
  [ -n "${TEAMUP_SESSION_NAME:-}" ] && { printf '%s' "$TEAMUP_SESSION_NAME"; return 0; }
  [ -n "$1" ] && command -v jq >/dev/null 2>&1 || return 0
  jq -r --arg sid "$1" 'select(.sessionId == $sid and (has("nameSource") | not)) | .name // empty' \
    "$CLAUDE_SESSIONS"/*.json 2>/dev/null | head -1 || true
}

print_member_count() { # subject
  printf '  %s — %s member(s)\n' "$1" "$(ls -A "$(mdir "$1")" 2>/dev/null | wc -l | tr -d ' ')"
}

channels_of_handle() { # handle -> one subject per line
  local sd subject
  [ -d "$BASE" ] || return 0
  for sd in "$BASE"/*/; do
    [ -d "$sd" ] || continue
    subject="$(basename "$sd")"
    [ -f "$(mdir "$subject")/$1" ] && echo "$subject"
  done
  return 0
}

register_session() { # subject handle pwd
  local file sid; file="$(sessions_file)"; sid="$(session_guid)"; mkdir -p "$BASE"
  if [ -f "$file" ]; then
    awk -F'\t' -v p="$3" -v s="$1" -v h="$2" '!($1==p && $2==s && $3==h)' \
      "$file" > "$file.tmp" && mv "$file.tmp" "$file"
  fi
  printf '%s\t%s\t%s\t%s\n' "$3" "$1" "$2" "$sid" >> "$file"
}

unregister_session() { # subject handle
  local file; file="$(sessions_file)"; [ -f "$file" ] || return 0
  awk -F'\t' -v s="$1" -v h="$2" '!($2==s && $3==h)' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
}

unregister_handle() { # handle
  local file; file="$(sessions_file)"; [ -f "$file" ] || return 0
  awk -F'\t' -v h="$1" '$3!=h' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
}

rekey_handle() { # old new
  local file; file="$(sessions_file)"; [ -f "$file" ] || return 0
  awk -F'\t' -v OFS='\t' -v old="$1" -v new="$2" '$3==old{$3=new} 1' \
    "$file" > "$file.tmp" && mv "$file.tmp" "$file"
}

# Collapse a message to a single safe TSV line (tabs/newlines -> spaces).
oneline() { printf '%s' "$*" | tr '\t\n\r' '   '; }

append() { # subject from type body
  local subject=$1 from=$2 type=$3 body=$4
  mkdir -p "$(dirname "$(chan "$subject")")"
  printf '%s\t%s\t%s\t%s\n' "$(now)" "$from" "$type" "$(oneline "$body")" >> "$(chan "$subject")"
}

linecount() { [ -f "$1" ] && wc -l < "$1" | tr -d ' ' || echo 0; }

# Stamp every message with its stable id (seq = 1-based line number):
# "seq <TAB> ts <TAB> from <TAB> type <TAB> body". Empty if the channel is new.
numbered() { # subject
  local file; file="$(chan "$1")"
  [ -f "$file" ] || return 0
  awk -F'\t' '{ printf "%d\t%s\n", NR, $0 }' "$file"
}

# Pretty-print numbered lines from stdin: "#seq [time] handle (type) body"
pretty() {
  awk -F'\t' '{
    split($2, stamp, "T"); clock = substr(stamp[2], 1, 8)
    printf "  #%s [%s] %s (%s) %s\n", $1, clock, $3, $4, $5
  }'
}

# Peer messages (not from this handle) with seq greater than `since`, seq-stamped.
# c+0 coerces numeric: an empty/garbage value would otherwise make "$1 > c" a
# string compare and flag everything.
peer_lines_since() { # subject handle since
  numbered "$1" | awk -F'\t' -v c="$3" -v me="$2" '$1 > c+0 && $3!=me'
}

# Messages from others since this handle's cursor, seq-stamped. Empty if none.
fresh_lines() { # subject handle
  local cur; cur="$(cat "$(cursor "$1" "$2")" 2>/dev/null || echo 0)"
  peer_lines_since "$1" "$2" "$cur"
}

count_lines() { awk 'END{print NR+0}'; }

# stdin filter: keep only messages someone actually wrote. A ping/bye is presence,
# not mail — counting it as unread would let a peer merely joining block your idle.
spoken_only() { awk -F'\t' '$4=="say" || $4=="ack" || $4=="ask"'; }

# stdin filter: what justifies waking an idle agent. Everything a peer wrote, plus a
# join `ping` — "a new peer appeared" is a cue to open the huddle, and it is the only
# thing that reaches a peer who joins and then waits to be briefed instead of
# speaking first (§1/§2 tell it to speak, but nothing enforces that).
# A `bye` is excluded: a departure is never actionable for an idle agent, and if a
# leaving peer's parting message matters, that `say` wakes you on its own.
worth_waking_for() { awk -F'\t' '$4!="bye"'; }

# What a `wait` may legitimately fire on: peer lines this handle has neither read
# (cursor) nor already been woken for (woken mark) — a conjunction, so a wait
# re-armed while older unread sits there does NOT re-fire on it. The woken mark is
# only ever advanced by an actual fire, never by `recv`; letting a checkpoint recv
# advance it would silently swallow the next real wake.
# Whether a line counts as UNREAD is a separate question from whether it justifies a
# WAKE — see spoken_only vs worth_waking_for.
unwoken_lines() { # subject handle
  local mark; mark="$(cat "$(woken "$1" "$2")" 2>/dev/null || echo 0)"
  fresh_lines "$1" "$2" | worth_waking_for | awk -F'\t' -v w="$mark" '$1 > w+0'
}

record_woken() { # subject handle numbered-lines
  printf '%s\n' "$3" | awk -F'\t' 'END{print $1}' > "$(woken "$1" "$2")"
}

# How to become reachable while idle WITHOUT holding a wait open. Every harness has an
# answer, and on none of them is it "wait again": which one applies is told by the env
# var that carries the session GUID (the pi extension exports TEAMUP_SESSION itself).
how_to_go_idle() {
  if [ -n "${TEAMUP_SESSION:-}" ]; then
    echo "on pi: just end your turn — the teamup extension's fs.watch wakes you when a peer speaks."
  elif [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
    echo "on claude-code: arm ONE background 'wait --timeout 0' (never a bounded one) and end your turn."
  else
    echo "end your turn — unread is surfaced to you the next time you are invoked."
  fi
}

# A bounded wait is a foreground blocking read for a live huddle. Expiring twice with
# the channel unchanged in between is the thrashing loop — say/wait/"still quiet,
# re-arming"/wait — which costs a turn per lap and reaches no one. Comparing the
# channel size across expiries needs no counter and cannot misfire: any traffic at all,
# the agent's own message included, makes this a real huddle rather than a lap.
report_expiry() { # subject handle
  local mark size; mark="$(expiry "$1" "$2")"; size="$(linecount "$(chan "$1")")"
  echo "wake: none reason=timeout — no one spoke, nothing to read"
  [ "$(cat "$mark" 2>/dev/null || true)" = "$size" ] &&
    echo "STOP LOOPING: second expiry with nothing new on '$1' — $(how_to_go_idle)"
  echo "$size" > "$mark"
}

# A pid alone is not proof: after a crash (or a `kill -9` sweep) the OS recycles pids,
# and a stale pidfile then names an innocent process — which would make every standby
# defer forever to something that is not a listener at all.
listener_is_alive() { # pidfile — true only for another live process that is a wait
  local pid; pid="$(cat "$1" 2>/dev/null || true)"
  [ -n "$pid" ] && [ "$pid" != "$$" ] && kill -0 "$pid" 2>/dev/null &&
    ps -p "$pid" -o command= 2>/dev/null | grep -q 'teamup wait'
}

# Take ownership of the listener slot. Check-then-write would let two standbys that
# spot the same dead owner both believe they won, so this verifies afterwards instead:
# whoever's pid is in the file at the end owns it, everyone else stands by. Lock-free
# on purpose — a lock file dropped by a killed process would leave the channel with no
# possible owner, which is worse than the rare double-wake it prevents.
claim_listener() { # pidfile
  listener_is_alive "$1" && return 1
  echo "$$" > "$1"
  [ "$(cat "$1" 2>/dev/null || true)" = "$$" ]
}

release_listener() { # pidfile
  [ "$(cat "$1" 2>/dev/null || true)" = "$$" ] && rm -f "$1" || true
}

# No need to kill this handle's listeners: removing the member file makes every one of
# them — owner and standby alike — exit on its own with a labelled reason. Signalling
# them instead would hand the agent an unexplained background exit, which is the very
# confusion this design removes.
# The member file goes FIRST and the `bye` second: the bye is what wakes the listeners
# via fswatch, so writing it first lets one check its membership in the moment before
# the file is gone, conclude it is still a member, and block on until some later
# message — retiring long after the agent left.
leave_channel() { # subject handle
  rm -f "$(mdir "$1")/$2" "$(cursor "$1" "$2")" "$(woken "$1" "$2")" "$(expiry "$1" "$2")"
  append "$1" "$2" bye "left the channel"
  echo "left '$1'."
}

has_spoken() { # subject handle — has this handle ever appeared on the channel?
  local file; file="$(chan "$1")"
  [ -f "$file" ] && awk -F'\t' -v me="$2" '$2==me{found=1} END{exit !found}' "$file"
}

# Highest seq of a message not from this handle (empty if none).
latest_peer_seq() { # subject handle
  numbered "$1" | awk -F'\t' -v me="$2" '$3!=me{seq=$1} END{if(seq) print seq}'
}

# Count asks aimed at this handle (@handle) that it has not yet answered. Any
# later message from the handle — an `ack`, a `say`, anything — clears the ask,
# so prose answers count and there is no ack-parsing policy to drift out of sync.
pending_asks_for_me() { # subject handle
  numbered "$1" | awk -F'\t' -v me="$2" '
    $3==me { answered_through=$1 }
    $4=="ask" && $3!=me && index($5, "@" me) { asked[$1]=1 }
    END { n=0; for (seq in asked) if (seq+0 > answered_through+0) n++; print n+0 }
  '
}

# Block until the channel changes, then return so the caller re-checks. fswatch
# wakes only on a real change (free for an indefinite watcher); sleep is the
# universal fallback and is fine for short bounded waits.
block_for_change() { # channel-file
  if [ -f "$1" ] && command -v fswatch >/dev/null 2>&1; then
    fswatch -1 "$1" >/dev/null 2>&1 || sleep 2
  else
    sleep 2
  fi
}

require_handle() {
  [ -n "${HANDLE:-}" ] ||
    die "missing --as <handle> (this session has no name to derive one from — ask the user to $(name_session_command) it, or pass --as)"
}

# An agent actively saying/asking/receiving on a channel IS on it. Restore its
# roster entry + registry row if a prior session incarnation (resume, stale
# session-end) dropped them, so `roster` and the statusline stop under-reporting
# a live participant that keeps talking. Skips when the member file already
# exists, so it never clobbers another session holding this handle.
# RESTORES ONLY, never invents: a handle that has never appeared on the channel is
# a typo in --as, and materialising it would show peers a phantom member that
# never answers (and split the typing agent's read-cursor in two).
ensure_member() { # subject
  local member; member="$(mdir "$1")/$HANDLE"
  [ -f "$member" ] && return 0
  [ -d "$BASE/$HANDLE" ] &&
    die "'$HANDLE' is a CHANNEL name, not a handle — you almost certainly meant --as <your handle>"
  has_spoken "$1" "$HANDLE" ||
    die "'$HANDLE' has never been on '$1' — typo in --as? to take part, run: teamup join $1 --as $HANDLE"
  mkdir -p "$(mdir "$1")"
  printf 'pwd=%s\ndoing=%s\njoined=%s\nsession=%s\n' \
    "$PWD_ARG" "(rejoined)" "$(now)" "$(session_guid)" > "$member"
  register_session "$1" "$HANDLE" "$PWD_ARG"
}

# ---- arg parsing --------------------------------------------------------------
CMD="${1:-}"; shift || usage
SUBJECT=""; HANDLE=""; PWD_ARG="$PWD"; DOING=""; TIMEOUT="$DEFAULT_WAIT"; LAST=20; ALL=false; FORCE=false
TO=""; RE=""; SID=""
MSG=()
while [ $# -gt 0 ]; do
  case "$1" in
    --as)      HANDLE="$2"; shift 2 ;;
    --pwd)     PWD_ARG="$2"; shift 2 ;;
    --session) SID="$2"; shift 2 ;;
    --doing)   DOING="$2"; shift 2 ;;
    --timeout) TIMEOUT="$2"; shift 2 ;;
    --last)    LAST="$2"; shift 2 ;;
    --to)      TO="$2"; shift 2 ;;
    --re)      RE="$2"; shift 2 ;;
    --all)     ALL=true; shift ;;
    --force)   FORCE=true; shift ;;
    --) shift; MSG+=("$@"); break ;;
    -*) die "unknown flag: $1 (put free-form message text after -- )" ;;
    *) if [ -z "$SUBJECT" ]; then SUBJECT="$1"; else MSG+=("$1"); fi; shift ;;
  esac
done

# ---- commands -----------------------------------------------------------------
case "$CMD" in
  join)
    [ -n "$SUBJECT" ] || usage
    # Default the handle to this session's own name, so the identity peers address
    # is the identity the user sees on their session — no invented third name.
    [ -n "$HANDLE" ] || HANDLE="$("$0" session-name || true)"
    require_handle
    mkdir -p "$(mdir "$SUBJECT")"
    sid="$(session_guid)"
    member="$(mdir "$SUBJECT")/$HANDLE"
    # A handle owns one cursor file (.cursor.$HANDLE); two live sessions sharing a
    # handle would race it and silently drop/re-show messages. Refuse if the handle
    # is already held by a DIFFERENT session. Same session re-joining (e.g. after a
    # resume — getSessionId is stable) keeps its GUID, so it's allowed.
    if [ -f "$member" ]; then
      held="$(sed -n 's/^session=//p' "$member")"
      [ -z "$sid" ] || [ -z "$held" ] || [ "$held" = "$sid" ] || \
        die "handle '$HANDLE' is already on '$SUBJECT' from another session — pick a different handle"
    fi
    printf 'pwd=%s\ndoing=%s\njoined=%s\nsession=%s\n' "$PWD_ARG" "$(oneline "$DOING")" "$(now)" "$sid" \
      > "$member"
    append "$SUBJECT" "$HANDLE" ping "joined — doing: ${DOING:-?} @ $PWD_ARG"
    register_session "$SUBJECT" "$HANDLE" "$PWD_ARG"
    # Cursor to end so future recv only shows what comes next.
    printf '%s' "$(linecount "$(chan "$SUBJECT")")" > "$(cursor "$SUBJECT" "$HANDLE")"
    echo "joined '$SUBJECT' as '$HANDLE'."
    echo "--- on channel now ---"
    "$0" roster "$SUBJECT"
    echo "--- recent ---"
    "$0" peek "$SUBJECT" --last "$LAST"
    ;;

  # For a hook or an agent that has to tell the USER how to name this session.
  name-command)
    name_session_command
    echo
    ;;

  session-name)
    sid="$SID"; [ -n "$sid" ] || sid="$(session_guid)"
    name="$(chosen_session_name "$sid")"
    [ -n "$name" ] || exit 1
    as_handle "$name"
    echo
    ;;

  # The user renamed the session under us (or at least the name and the handle
  # disagree), so peers are addressing a name that isn't shown anywhere. Move the
  # whole identity — presence, read-cursor, listener pidfile, registry rows — on
  # every channel at once, since a session name is not per-channel. Unread stays
  # unread: the cursor travels with the handle.
  rename)
    require_handle
    [ -n "$TO" ] || usage
    new="$(as_handle "$TO")"
    [ "$new" != "$HANDLE" ] || die "already on the channel as '$HANDLE'"
    subjects="$(channels_of_handle "$HANDLE")"
    [ -n "$subjects" ] || die "'$HANDLE' is on no channels — nothing to rename"
    while read -r s; do
      [ -f "$(mdir "$s")/$new" ] &&
        die "handle '$new' is already on '$s' — pick a different session name"
    done <<< "$subjects"
    while read -r s; do
      mv "$(mdir "$s")/$HANDLE" "$(mdir "$s")/$new"
      mv "$(cursor "$s" "$HANDLE")" "$(cursor "$s" "$new")" 2>/dev/null || true
      mv "$(waitpid "$s" "$HANDLE")" "$(waitpid "$s" "$new")" 2>/dev/null || true
      mv "$(woken "$s" "$HANDLE")" "$(woken "$s" "$new")" 2>/dev/null || true
      mv "$(expiry "$s" "$HANDLE")" "$(expiry "$s" "$new")" 2>/dev/null || true
      # Announced as the NEW handle, so it doesn't land in our own unread.
      append "$s" "$new" say "renamed: $HANDLE → $new — address me as '$new' from now on"
      echo "renamed on '$s': $HANDLE → $new."
    done <<< "$subjects"
    rekey_handle "$HANDLE" "$new"
    echo "pass --as $new from now on."
    ;;

  say|send)
    [ -n "$SUBJECT" ] || usage; require_handle; ensure_member "$SUBJECT"
    if [ ${#MSG[@]} -gt 0 ]; then text="${MSG[*]}"; else text="$(cat)"; fi
    [ -n "$text" ] || die "nothing to say"
    append "$SUBJECT" "$HANDLE" say "$text"
    echo "sent."
    ;;

  recv)
    [ -n "$SUBJECT" ] || usage; require_handle; ensure_member "$SUBJECT"
    fresh="$(fresh_lines "$SUBJECT" "$HANDLE")"
    printf '%s' "$(linecount "$(chan "$SUBJECT")")" > "$(cursor "$SUBJECT" "$HANDLE")"
    unread="$(printf '%s' "$fresh" | spoken_only | count_lines)"
    pending="$(pending_asks_for_me "$SUBJECT" "$HANDLE")"
    senders="$(printf '%s' "$fresh" | spoken_only | awk -F'\t' 'NF{print $3}' | sort -u | paste -sd, -)"
    printf 'summary: unread=%s asks_for_me=%s from=%s\n' "$unread" "$pending" "${senders:-none}"
    if [ -n "$fresh" ]; then printf '%s\n' "$fresh" | pretty; else echo "  (nothing new)"; fi
    ;;

  ask)
    [ -n "$SUBJECT" ] || usage; require_handle; ensure_member "$SUBJECT"
    if [ ${#MSG[@]} -gt 0 ]; then text="${MSG[*]}"; else text="$(cat)"; fi
    [ -n "$text" ] || die "nothing to ask"
    [ -n "$TO" ] && text="@$TO $text"
    append "$SUBJECT" "$HANDLE" ask "$text"
    echo "asked${TO:+ @$TO}."
    ;;

  ack)
    [ -n "$SUBJECT" ] || usage; require_handle
    seq="$RE"; [ -n "$seq" ] || seq="$(latest_peer_seq "$SUBJECT" "$HANDLE")"
    [ -n "$seq" ] || die "nothing to ack — no peer messages yet"
    note="${MSG[*]}"
    append "$SUBJECT" "$HANDLE" ack "re:#$seq${note:+ $note}"
    echo "acked #$seq."
    ;;

  status)
    require_handle
    # No subject -> my-teams overview: every channel where I'm a member, with its
    # roster size (a crashed session that never left inflates the count, same
    # staleness caveat as `channels`). With a subject -> the per-channel unread/ask
    # surface the hook keys on (exit 0/1/2, cursor untouched).
    if [ -z "$SUBJECT" ]; then
      subjects="$(channels_of_handle "$HANDLE")"
      [ -n "$subjects" ] || { echo "  (on no teams)"; exit 0; }
      while read -r s; do print_member_count "$s"; done <<< "$subjects"
      exit 0
    fi
    unread="$(fresh_lines "$SUBJECT" "$HANDLE" | spoken_only | count_lines)"
    pending="$(pending_asks_for_me "$SUBJECT" "$HANDLE")"
    # listener= lets an agent see whether it still needs to arm one WITHOUT wrapping
    # `wait` in a guard script (whose own exit would wake it — the churn this whole
    # design is about). Cursor-safe, so it is also the tester's assertion point.
    listener_is_alive "$(waitpid "$SUBJECT" "$HANDLE")" && live=live || live=none
    printf 'summary: unread=%s asks_for_me=%s listener=%s\n' "$unread" "$pending" "$live"
    [ "$pending" -gt 0 ] && exit 2
    [ "$unread" -gt 0 ] && exit 1
    exit 0
    ;;

  teams)
    # Compact one-line list of THIS session's joined channels, for a statusline.
    # Keyed by session GUID (--session), else cwd (--pwd) for GUID-less harnesses.
    # Markers per channel: ! = an ask aimed at you, * = unread (no ask). Prints
    # nothing (exit 0) when on no teams, so a statusline can append unconditionally.
    file="$(sessions_file)"; [ -f "$file" ] || exit 0
    if [ -n "$SID" ]; then
      rows="$(awk -F'\t' -v s="$SID" '$4==s{print $2"\t"$3}' "$file")"
    else
      rows="$(awk -F'\t' -v c="$PWD_ARG" '$1==c && $4==""{print $2"\t"$3}' "$file")"
    fi
    [ -n "$rows" ] || exit 0
    out=""
    while IFS=$'\t' read -r subject handle; do
      [ -n "$subject" ] || continue
      unread="$(fresh_lines "$subject" "$handle" | spoken_only | count_lines)"
      pending="$(pending_asks_for_me "$subject" "$handle")"
      if [ "$pending" -gt 0 ]; then mark="!"; elif [ "$unread" -gt 0 ]; then mark="*"; else mark=""; fi
      out="$out $subject$mark"
    done <<< "$rows"
    printf '%s' "${out# }"
    ;;

  # THE INVARIANT: a background `wait` is the agent's wake signal, and the harness
  # reads nothing but "the process exited". So this must exit ONLY when something has
  # happened on the channel that this handle has not already seen — and must SAY which
  # case it was on its last line. Every unexplained exit lands on the agent as a
  # message that isn't there.
  #
  # Signal-only: never advances the cursor — recv is the sole consumer. A detached
  # wait's stdout goes to a file the agent never reads, so consuming here would
  # drop the very message that woke it.
  wait)
    [ -n "$SUBJECT" ] || usage; require_handle; ensure_member "$SUBJECT"
    file="$(chan "$SUBJECT")"
    # An indefinite wait is the armed idle listener the Stop hook looks for, so it
    # owns the pidfile. Only the owner may fire: a second armed wait would deliver a
    # duplicate wake for one message, so it STANDS BY instead — blocking (not
    # exiting, which would itself be a false wake) until the owner dies and it can
    # take over. That makes arming idempotent from the harness's point of view.
    # A bounded wait is a foreground blocking read (§huddle): it never touches the
    # pidfile and always fires, and its own fire marks the message woken — so the
    # armed listener won't wake the agent again for what it already delivered.
    if [ "$TIMEOUT" -gt 0 ]; then
      deadline=$(( $(date +%s) + TIMEOUT )); pidf=""
    else
      deadline=0; pidf="$(waitpid "$SUBJECT" "$HANDLE")"
      listener_is_alive "$pidf" &&
        echo "standby: '$HANDLE' already has a live listener on '$SUBJECT' — blocking until it needs replacing."
      # A handler that only cleans up would let the script RESUME after the signal,
      # so a `kill` on a listener has to route through an explicit exit.
      trap 'release_listener "$pidf"' EXIT
      trap 'echo "wake: none reason=killed — this listener was signalled, nothing to read"; exit 1' INT TERM
    fi
    while :; do
      # `leave` (or a lifecycle hook's leave) removes the member file. A listener
      # that outlived its membership must stop rather than wake the agent about a
      # channel it is no longer on — and standby listeners hold no pidfile, so this
      # is the only thing that reaches them.
      [ -f "$(mdir "$SUBJECT")/$HANDLE" ] ||
        { echo "wake: none reason=left-channel — '$HANDLE' is no longer on '$SUBJECT'"; exit 1; }
      if [ -n "$pidf" ] && ! claim_listener "$pidf"; then
        sleep "$STANDBY_POLL"
      else
        fresh="$(unwoken_lines "$SUBJECT" "$HANDLE")"
        if [ -n "$fresh" ] && [ -n "$pidf" ]; then
          # Both an idle listener and a foreground huddle wait can wake on the same
          # channel event, and whoever marks it woken first wins — a coin flip that
          # can cost the agent two wakes for one message. An idle listener's wake is
          # only delivered between turns anyway, so it can afford to lose: pause, then
          # re-check whether a reader in the same turn already claimed this one.
          sleep "$CONFIRM_DELAY"
          fresh="$(unwoken_lines "$SUBJECT" "$HANDLE")"
        fi
        if [ -n "$fresh" ]; then
          record_woken "$SUBJECT" "$HANDLE" "$fresh"
          spoken="$(printf '%s\n' "$fresh" | spoken_only | count_lines)"
          if [ "$spoken" -gt 0 ]; then
            printf 'wake: peer-spoke unread=%s — read them with: teamup recv %s --as %s\n' \
              "$spoken" "$SUBJECT" "$HANDLE"
          else
            printf 'wake: peer-joined unread=0 — a new peer is on the channel; open the huddle if you were waiting for one, else re-arm\n'
          fi
          printf '%s\n' "$fresh" | pretty
          exit 0
        fi
        block_for_change "$file"
      fi
      [ "$deadline" -ne 0 ] && [ "$(date +%s)" -ge "$deadline" ] &&
        { report_expiry "$SUBJECT" "$HANDLE"; exit 1; }
    done
    ;;

  roster)
    [ -n "$SUBJECT" ] || usage
    d="$(mdir "$SUBJECT")"
    [ -d "$d" ] && [ -n "$(ls -A "$d" 2>/dev/null)" ] || { echo "  (no members)"; exit 0; }
    for f in "$d"/*; do
      h="$(basename "$f")"
      p="$(sed -n 's/^pwd=//p' "$f")"; do="$(sed -n 's/^doing=//p' "$f")"
      printf '  %s — %s @ %s\n' "$h" "${do:-?}" "${p:-?}"
    done
    ;;

  peek)
    [ -n "$SUBJECT" ] || usage
    recent="$(numbered "$SUBJECT" | tail -n "$LAST")"
    [ -n "$recent" ] || { echo "  (channel empty)"; exit 0; }
    printf '%s\n' "$recent" | pretty
    ;;

  leave)
    require_handle
    if [ "$ALL" = true ]; then
      subjects="$(channels_of_handle "$HANDLE")"
      [ -n "$subjects" ] || { echo "no channels."; exit 0; }
      while read -r s; do leave_channel "$s" "$HANDLE"; done <<< "$subjects"
      unregister_handle "$HANDLE"
    else
      [ -n "$SUBJECT" ] || usage
      leave_channel "$SUBJECT" "$HANDLE"
      unregister_session "$SUBJECT" "$HANDLE"
    fi
    ;;

  channels)
    [ -d "$BASE" ] || { echo "  (none)"; exit 0; }
    for sd in "$BASE"/*/; do
      [ -d "$sd" ] || continue
      print_member_count "$(basename "$sd")"
    done
    ;;

  # Delete a whole channel: scrub its session-registry rows (so no peer's
  # lifecycle hook resurrects it) and remove the dir. Refuses while any member
  # is still present — `leave` first, or pass --force to nuke regardless.
  erase|cleanup)
    [ -n "$SUBJECT" ] || usage
    [ -d "$BASE/$SUBJECT" ] || { echo "no channel '$SUBJECT' to erase."; exit 0; }
    members="$(ls -A "$(mdir "$SUBJECT")" 2>/dev/null)"
    if [ -n "$members" ] && [ "$FORCE" != true ]; then
      die "'$SUBJECT' still has members: $(printf '%s' "$members" | tr '\n' ' '). Leave first, or re-run with --force."
    fi
    if [ -f "$(sessions_file)" ]; then
      awk -F'\t' -v s="$SUBJECT" '$2 != s' "$(sessions_file)" > "$(sessions_file).tmp" \
        && mv "$(sessions_file).tmp" "$(sessions_file)"
    fi
    rm -rf "$BASE/$SUBJECT"
    echo "erased channel '$SUBJECT'."
    ;;

  help|-h|--help) usage_text; exit 0 ;;

  *) usage ;;
esac
