#!/usr/bin/env bash
# teamup-spawn — launch a cooperating agent in a new terminal tab, joined to a channel.
#   teamup-spawn <claude|pi|codex> <subject> [--as HANDLE] [--dir DIR] [--color COLOR] [--no-steal|--no-color]
# The tab opens in the caller's terminal (Ghostty or iTerm, via term_spawn).
#
# Opens a tab (in DIR, default $PWD) running the agent with an initial prompt that
# invokes the suss-teamup skill to JOIN <subject>. You (the caller) should already
# have joined <subject> yourself so you're present when the peer arrives. Prints the
# spawned tab id.
#
# The SPAWNER assigns the peer's handle (--as, default <subject>-peer<n>, unique against
# the roster) and a claude or pi peer is named after it before it joins, so its session
# name IS its channel handle and it derives that handle on join — one name in the
# session, on the channel, and on the user's screen. Naming the session after the
# <subject> instead (what this did before) gave every peer on a channel the same name,
# and a peer that picked its own handle answered to a name shown nowhere.
#   claude -> `--name <handle>` at launch.
#   pi     -> a leading `/banner <handle>` argv message: pi dispatches slash commands
#             from argv and runs several messages in order, so the peer names ITSELF
#             before it joins — deterministic and focus-free, unlike a keystroke.
#             `/banner` is pi's `/rename`: it sets the session name the handle is derived
#             from (pi puts it in the footer and the terminal title) and paints the
#             banner, which pi's built-in `/name` does not.
#   codex  -> no launch-name flag and no argv command dispatch, so it still spawns
#             unnamed and picks its own handle.
#
# Color: claude has no launch flag for a session's color, so we type `/color <color>` into
# its tab — --color, else the spawning session's color, else a random palette pick.
# On iTerm, focus-free: claude launches with its join prompt and gets `/color` typed until
# its transcript records the color — its TUI drops keystrokes typed while it boots, so a
# single early attempt is silently lost (claude runs /color immediately, even mid-turn); codex launches
# bare and gets `/rename <handle>` then the join prompt typed. The tab gets the same color. On Ghostty, claude's `/color` is keystroked once
# the peer joins, which STEALS FOCUS and lands after its first turn, and codex spawns
# unnamed. Pass --no-steal (alias --no-color) to skip coloring.
set -eo pipefail

BASE_DIR="${SUSS_TEAMUP_DIR:-/tmp/suss-teamup}"
member_count() { ls -A "$BASE_DIR/$1/members" 2>/dev/null | wc -l | tr -d ' ' || true; }

# Hidden subcommand (backgrounded by the main flow): wait for the spawned peer to
# become interactive — proven by it joining the channel — then type one slash command
# into its tab. Best-effort; every failure is silent by design.
if [ "${1:-}" = __inject_cmd ]; then
  subject="$2"; handle="$3"; cmd="$4"; baseline="${5:-0}"
  for _ in $(seq 1 90); do
    [ "$(member_count "$subject")" -gt "$baseline" ] && break
    sleep 0.5
  done
  sleep 1   # let the freshly-live TUI settle before it reads typed input
  osascript - "$handle" "$cmd" <<'OSA' >/dev/null 2>&1 || true
on run argv
  set subj to item 1 of argv
  set cmd to item 2 of argv
  tell application "Ghostty" to activate
  delay 0.3
  tell application "System Events" to tell process "Ghostty"
    repeat with b in (radio buttons of tab group 1 of window 1)
      set t to ""
      try
        set t to title of b
      end try
      if t contains subj then
        click b
        delay 0.4
        keystroke cmd
        delay 0.2
        key code 36 -- Return
        return
      end if
    end repeat
  end tell
end run
OSA
  exit 0
fi

SESSION_COLORS=(red blue green yellow purple orange pink cyan)

type_into_iterm_session() { # session-id text seconds-before-enter
  osascript - "$1" "$2" "$3" <<'OSA' >/dev/null 2>&1 || true
on run argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s) is (item 1 of argv) then
            tell s to write text (ASCII character 21) newline NO
            delay 0.1
            tell s to write text (item 2 of argv) newline NO
            delay ((item 3 of argv) as real)
            tell s to write text ""
            return
          end if
        end repeat
      end repeat
    end repeat
  end tell
end run
OSA
}

iterm_session_field() { # session-id tty|name
  osascript -e "tell application \"iTerm2\" to repeat with w in windows
repeat with t in tabs of w
repeat with s in sessions of t
if (id of s) is \"$1\" then return $2 of s
end repeat
end repeat
end repeat" 2>/dev/null || true
}

is_agent_running() { # tty agent
  ps -t "${1#/dev/}" -o comm= 2>/dev/null | grep -qE "(^|/)$2\$"
}

settle_seconds()      { case "$1" in claude) echo 0 ;;   *) echo 2 ;;   esac; }
seconds_before_enter() { case "$1" in claude) echo 0.1 ;; *) echo 1.5 ;; esac; }

wait_for_agent() { # tty agent
  [ -n "$1" ] || return 1
  for _ in $(seq 1 300); do
    is_agent_running "$1" "$2" && { sleep "$(settle_seconds "$2")"; return 0; }
    sleep 0.1
  done
  return 1
}

claude_transcript() { # tty
  local pid session_id
  pid="$(ps -t "${1#/dev/}" -o pid=,comm= | awk '$2 ~ /(^|\/)claude$/ { print $1; exit }')"
  session_id="$(jq -r '.sessionId // empty' "$HOME/.claude/sessions/$pid.json" 2>/dev/null)"
  [ -n "$session_id" ] && printf '%s' "$HOME"/.claude/projects/*/"$session_id".jsonl
}

has_session_color() { # tty color
  local transcript; transcript="$(claude_transcript "$1")"
  [ -f "$transcript" ] && rg --no-config -q "\"agentColor\":\"$2\"" "$transcript"
}

color_claude_session() { # session-id tty color
  for _ in $(seq 1 30); do
    type_into_iterm_session "$1" "/color $3" "$(seconds_before_enter claude)"
    sleep 1
    has_session_color "$2" "$3" && return 0
  done
}

if [ "${1:-}" = __boot_iterm ]; then
  session="$2"; agent="$3"; color="$4"; shift 4
  [ -z "$color" ] || "$HOME/.dotfiles/bin/iterm_tab_style" --session "$session" --color "$color" >/dev/null 2>&1 || true
  tty="$(iterm_session_field "$session" tty)"
  wait_for_agent "$tty" "$agent" || exit 0
  [ "$agent" = claude ] && { color_claude_session "$session" "$tty" "$color"; exit 0; }
  for command in "$@"; do
    type_into_iterm_session "$session" "$command" "$(seconds_before_enter "$agent")"
    sleep "$(settle_seconds "$agent")"
  done
  exit 0
fi

agent="${1:-}"; subject="${2:-}"; shift 2 2>/dev/null || true
dir="$PWD"; no_color=false; handle=""; color=""
while [ $# -gt 0 ]; do
  case "$1" in
    --as)    handle="$2"; shift 2 ;;
    --dir)   dir="$2"; shift 2 ;;
    --color) color="$2"; shift 2 ;;
    --no-steal|--no-color) no_color=true; shift ;;
    *) echo "teamup-spawn: unknown flag $1" >&2; exit 1 ;;
  esac
done
[ -n "$agent" ] && [ -n "$subject" ] || { echo "usage: teamup-spawn <claude|pi|codex> <subject> [--as HANDLE] [--dir DIR] [--color $(IFS='|'; echo "${SESSION_COLORS[*]}")] [--no-steal|--no-color]" >&2; exit 1; }
is_session_color() { [[ " ${SESSION_COLORS[*]} " == *" $1 "* ]]; }
[ -z "$color" ] || is_session_color "$color" || { echo "teamup-spawn: --color must be one of: ${SESSION_COLORS[*]}" >&2; exit 1; }

free_peer_handle() {
  local candidate n=1
  candidate="$subject-peer"
  while [ -e "$BASE_DIR/$subject/members/$candidate" ]; do
    n=$((n + 1)); candidate="$subject-peer$n"
  done
  printf '%s' "$candidate"
}
[ -n "$handle" ] || handle="$(free_peer_handle)"

# The spawning session's color lives in its transcript as the last `agent-color`
# entry (absent or "default" → no custom color → let /color pick a random one).
# Found by glob, not `rg --files`: the user's ripgrep config caps files at 10MB, and a
# long-running spawner's transcript outgrows that, silently losing its color.
parent_color() {
  local transcripts
  [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || return 0
  transcripts=("$HOME"/.claude/projects/*/"$CLAUDE_CODE_SESSION_ID".jsonl)
  [ -f "${transcripts[0]}" ] || return 0
  rg --no-config -o '"type":"agent-color","agentColor":"[^"]*"' "${transcripts[0]}" \
    | tail -1 | sed 's/.*:"//;s/"$//' | grep -vx default
}

# cyc = `claude --chrome … --mcp-config {playwright}` so a spawned peer has browser
# tools. --mcp-config is variadic (space-separated), so a `--` terminates options
# and keeps the prompt from being read as another config path. claude discovers the
# skill globally as /suss-teamup; pi invokes skills as /skill:<name>. codex (the codex alias =
# bypass flags) does NOT dispatch slash commands from argv — argv is a plain prompt —
# so it gets a natural-language instruction naming the skill (from ~/.agents/skills).
# `|| true` because no color is the normal case (an uncolored spawner, or a transcript
# with no agentColor yet), and pipefail would otherwise make that abort the spawn.
color="${color:-$(parent_color || true)}"
color="${color:-${SESSION_COLORS[RANDOM % ${#SESSION_COLORS[@]}]}}"
case "$agent" in
  claude) run="cyc --name '$handle' -- '/suss-teamup $subject'"; inject="/color $color" ;;
  # pi takes several argv messages and runs them in order, so it names ITSELF before it
  # joins — no keystroke injection, no focus steal. `/banner` is pi's `/rename`: it sets
  # the session name the handle is derived from AND paints the banner, which is the only
  # place the user can see which peer a tab is.
  pi)     run="pi '/banner $handle' '/skill:suss-teamup $subject'"; inject="" ;;
  codex)  codex_prompt="Use the suss-teamup skill. Your first action: ~/.claude/skills/suss-teamup/scripts/teamup join $subject --as $handle"
          run="codex '$codex_prompt'"; inject="" ;;
  *)      echo "teamup-spawn: agent must be 'claude', 'pi', or 'codex'" >&2; exit 1 ;;
esac

# Snapshot membership BEFORE the peer joins, so the injector can detect its arrival
# (member count ticking up = the peer is interactive).
baseline="$(member_count "$subject")"
terminal="$(term_spawn --resolve)"
tab_color="$color"; [ "$no_color" = true ] && tab_color=""
case "$terminal:$agent" in
  iterm:claude)
    session="$(term_spawn --dir "$dir" --run "$run")"
    [ "$no_color" = true ] ||
      nohup "$0" __boot_iterm "$session" claude "$color" >/dev/null 2>&1 &
    inject="" ;;
  iterm:codex)
    session="$(term_spawn --dir "$dir" --run codex)"
    nohup "$0" __boot_iterm "$session" codex "$tab_color" "/rename $handle" "$codex_prompt" >/dev/null 2>&1 & ;;
  *) term_spawn --dir "$dir" --run "$run" >/dev/null ;;
esac
echo "spawned $agent on '$subject' as '$handle'."

if [ -n "$inject" ] && [ "$no_color" != true ]; then
  nohup "$0" __inject_cmd "$subject" "$handle" "$inject" "$baseline" >/dev/null 2>&1 &
fi
