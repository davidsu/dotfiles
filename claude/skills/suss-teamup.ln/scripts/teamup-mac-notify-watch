#!/usr/bin/env -S python3 -I
"""teamup-mac-notify-watch on <name> <subject> <handle> <app-bundle-id> <title> | off <name> | status

Delivers every new macOS notification from one app with one exact title to a teamup channel,
aimed at one agent. Each watch posts under its own name, so several can share one inbox. Reads Notification Center's own database, so whatever the app shows on
screen (WhatsApp Web in Brave, for one) reaches the agent without driving the app.
"""
import json
import os
import plistlib
import signal
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
TEAMUP = HERE / "teamup"
BASE = Path(os.environ.get("SUSS_TEAMUP_DIR", "/tmp/suss-teamup"))
POLL_SECONDS = float(os.environ.get("TEAMUP_NOTIFY_POLL", "5"))
NOTIFICATION_DB = Path.home() / "Library/Group Containers/group.com.apple.usernoted/db2/db"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "suss-teamup/notify"
TEAMUP_ENV = {**{key: value for key, value in os.environ.items()
                 if key not in ("CLAUDE_CODE_SESSION_ID", "TEAMUP_SESSION", "CODEX_THREAD_ID", "TEAMUP_SESSION_NAME")},
              "TEAMUP_SLACK": "off"}


def config_file(name): return STATE / f"{name}.json"
def pid_file(name): return STATE / f"{name}.pid"
def log_file(name): return STATE / f"{name}.log"


def teamup(*args):
    return subprocess.run([str(TEAMUP), *args], env=TEAMUP_ENV, capture_output=True, text=True).returncode == 0


def query_notifications(sql, params):
    with sqlite3.connect(f"file:{NOTIFICATION_DB}?mode=ro", uri=True) as db:
        return db.execute(sql, params).fetchall()


def newest_record_id():
    return query_notifications("select coalesce(max(rec_id), 0) from record", ())[0][0]


def records_after(record_id, app):
    return query_notifications(
        "select r.rec_id, r.data from record r join app a on a.app_id = r.app_id "
        "where r.rec_id > ? and a.identifier = ? order by r.rec_id", (record_id, app))


def as_notification(data):
    request = plistlib.loads(data).get("req", {})
    return request.get("titl", ""), request.get("body", "")


def deliver(config, body):
    teamup("recv", config["subject"], "--as", config["name"])
    return teamup("say", config["subject"], "--as", config["name"], "--", f"@{config['handle']} new in {config['title']}: {body}")


def deliver_new_notifications(config):
    for record_id, data in records_after(config["last_record_id"], config["app"]):
        title, body = as_notification(data)
        if title == config["title"] and not deliver(config, body):
            return
        config["last_record_id"] = record_id
        config_file(config["name"]).write_text(json.dumps(config))


def watch_forever(name):
    config = json.loads(config_file(name).read_text())
    while True:
        try:
            deliver_new_notifications(config)
        except sqlite3.Error as error:
            print(f"{time.ctime()} notification db unreadable: {error}", flush=True)
        time.sleep(POLL_SECONDS)


def watcher_pid(name):
    try:
        pid = int(pid_file(name).read_text())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def start(name, subject, handle, app, title):
    if pid := watcher_pid(name):
        return print(f"'{name}' is already watching (pid {pid}).")
    STATE.mkdir(parents=True, exist_ok=True)
    config = {"name": name, "subject": subject, "handle": handle, "app": app, "title": title, "last_record_id": newest_record_id()}
    config_file(name).write_text(json.dumps(config))
    teamup("join", subject, "--as", name, "--pwd", "mac-notify", "--doing", f"{app} notifications titled '{title}' → @{handle}")
    with open(log_file(name), "a") as log:
        process = subprocess.Popen([sys.executable, "-I", __file__, "__run", name],
                                   stdout=log, stderr=log, start_new_session=True)
    pid_file(name).write_text(str(process.pid))
    print(f"'{name}' watching {app} notifications titled '{title}' → @{handle} on '{subject}' (pid {process.pid}); log: {log_file(name)}")


def stop(name):
    if pid := watcher_pid(name):
        os.kill(pid, signal.SIGTERM)
    pid_file(name).unlink(missing_ok=True)
    teamup("leave", json.loads(config_file(name).read_text())["subject"], "--as", name)
    print(f"stopped '{name}'.")


def print_status():
    for config_path in sorted(STATE.glob("*.json")):
        config = json.loads(config_path.read_text())
        pid = watcher_pid(config["name"])
        state = f"watching (pid {pid})" if pid else "stopped"
        print(f"  {config['name']} — {state}: {config['app']} '{config['title']}' → @{config['handle']} on {config['subject']}")


USAGE = __doc__.strip().splitlines()[0]
COMMANDS = {
    "on": (start, 5),
    "off": (stop, 1),
    "status": (print_status, 0),
    "__run": (watch_forever, 1),
}

if __name__ == "__main__":
    command, arity = COMMANDS.get(sys.argv[1] if len(sys.argv) > 1 else "", (None, 0))
    if not command or len(sys.argv) - 2 != arity:
        sys.exit(f"usage: {USAGE}")
    command(*sys.argv[2:])
