#!/usr/bin/env bash
# teamup-slack on|off [subject] | status | url <subject> — mirror teamup channels into Slack threads
# through the claude.ai Slack connector. One bridge daemon serves every mirrored channel.
# Design, auth and failure modes: resources/slack_mirror.md.
set -uo pipefail

unset CLAUDE_CODE_SESSION_ID TEAMUP_SESSION CODEX_THREAD_ID TEAMUP_SESSION_NAME

readonly HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly TEAMUP="$HERE/teamup"
readonly BASE="${SUSS_TEAMUP_DIR:-/tmp/suss-teamup}"
readonly HANDLE="${TEAMUP_SLACK_HANDLE:-david}"
readonly INBOUND_POLL_SECONDS="${TEAMUP_SLACK_POLL:-30}"
readonly OUTBOUND_TICK_SECONDS=5
readonly BACKFILL_LINES=20
readonly CHANNEL_FILE="$HERE/../slack-channel"
readonly THREAD_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/suss-teamup/slack"
readonly RETIRE_AFTER_EMPTY_SECONDS=120
readonly REPORT_DOWN_AFTER_SECONDS=300
readonly LATE_REPLY_MARGIN_SECONDS=60
readonly ADOPTABLE_ROOT_MAX_AGE_SECONDS=86400
readonly TOP_LEVEL_TAG=" [top]"   # same suffix `teamup --top` writes: this line goes to the channel's top level, not the thread
readonly GIST_MAX_CHARS=240
readonly CODE_BLOCK_MAX_CHARS=3500
mkdir -p "$THREAD_STATE"
readonly SEND_QUEUE="$THREAD_STATE/bridge.queue"
readonly DAEMON_PID_FILE="$THREAD_STATE/bridge.pid"
readonly DAEMON_LOG="$THREAD_STATE/bridge.log"
CONNECTOR_LOG="$DAEMON_LOG"

die() { echo "teamup-slack: $*" >&2; exit 1; }

source "$HERE/slack_connector.sh"
source "$HERE/slack_inbound.sh"
readonly FLUSH_MAX_POSTS=$(( CONNECTOR_MAX_TURNS - 1 ))   # one call per turn, and the relay's closing "done" needs the last turn
readonly MAX_POST_ATTEMPTS=3

readonly MACHINE_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/suss-teamup/local.conf"

is_slack_off_on_this_machine() { grep -qxE 'slack[[:space:]]*=[[:space:]]*off' "$MACHINE_CONFIG" 2>/dev/null; }
is_slack_opted_out() { [ -f "$BASE/$1/.slack.off" ]; }
is_throwaway() { [ -f "$BASE/$1/.slack.throwaway" ]; }

thread_state_dir() { # subject — a throwaway channel's thread dies with the channel
  is_throwaway "$1" && printf '%s/%s' "$BASE" "$1" || printf '%s' "$THREAD_STATE"
}

thread_file() { printf '%s/%s.thread' "$(thread_state_dir "$1")" "$1"; }
posted_file() { printf '%s/%s.posted' "$(thread_state_dir "$1")" "$1"; }
relayed_file() { printf '%s/%s.relayed' "$(thread_state_dir "$1")" "$1"; }
engaged_file() { printf '%s/%s.engaged' "$(thread_state_dir "$1")" "$1"; }
url_file() { printf '%s/%s.url' "$(thread_state_dir "$1")" "$1"; }
mirror_marker() { printf '%s/%s/.slack.on' "$BASE" "$1"; }
empty_since_file() { printf '%s/%s/.slack.empty_since' "$BASE" "$1"; }
broken_file() { printf '%s/%s/.slack.broken' "$BASE" "$1"; }

dedicated_channel_file() { printf '%s.%s' "$CHANNEL_FILE" "$1"; }
has_dedicated_slack_channel() { ! is_throwaway "$1" && [ -f "$(dedicated_channel_file "$1")" ]; }
slack_route_of() { is_throwaway "$1" && echo throwaway || echo "$1"; }
has_own_slack_channel() { [ -f "$(dedicated_channel_file "$(slack_route_of "$1")")" ]; } # dedicated or throwaway: top-level posts are not noise for other channels

slack_channel_of() { # subject
  [ -n "${TEAMUP_SLACK_CHANNEL:-}" ] && { printf '%s' "$TEAMUP_SLACK_CHANNEL"; return; }
  cat "$(dedicated_channel_file "$(slack_route_of "$1")")" 2>/dev/null || cat "$CHANNEL_FILE" 2>/dev/null ||
    die "no Slack destination: slack-channel is missing at the skill root"
}

# --- outbound: posts are queued, then sent in one relay per flush, in order ---

send_message_args() { # channel text [thread_ts] → connector arguments
  jq -nc --arg channel "$1" --arg text "$2" --arg thread "${3:-}" \
    '{channel_id: $channel, message: $text} + (if $thread == "" then {} else {thread_ts: $thread} end)'
}

queue_post() { # subject text [thread_ts]
  jq -nc --arg subject "$1" --argjson args "$(send_message_args "$(slack_channel_of "$1")" "$2" "${3:-}")" \
    '{subject: $subject, arguments: $args, attempts: 0}' >> "$SEND_QUEUE"
}

post_top_level() { queue_post "$1" "$2"; }                          # subject text — where the user reads the channel
post_to_thread() { queue_post "$1" "$2" "$(cat "$(thread_file "$1")")"; } # subject text

record_posted() { # subject ts — an own post comes back on the inbound poll and must be skipped there
  echo "$2" >> "$(posted_file "$1")"
}

send_now() { # channel text [thread_ts] → ts, the one post that cannot wait for a flush: a thread root
  local link; link="$(connector_call slack_send_message "$(send_message_args "$1" "$2" "${3:-}")")" || return 1
  remember_team_url "$(jq -r '.message_link // empty' <<<"$link")"
  jq -r '.message_context.message_ts // empty' <<<"$link"
}

send_calls_of() { jq -sc 'map({name: "slack_send_message", arguments: .arguments})'; } # queued-json lines on stdin

log_line() { echo "$(date '+%F %T') $*" >&2; }

post_landed() { # queued-json paired-json — records the confirmed post; else 1 with the connector's error in POST_ERROR
  local subject args sent
  subject="$(jq -r '.subject' <<<"$1")"; args="$(jq -c '.arguments' <<<"$1")"
  sent="$(result_of "$2" slack_send_message "$args" 2>&1)" || { POST_ERROR="$sent"; return 1; }
  remember_team_url "$(jq -r '.message_link // empty' <<<"$sent")"
  record_posted "$subject" "$(jq -r '.message_context.message_ts // empty' <<<"$sent")"
}

post_preview() { jq -r '"\(.subject): \(.arguments.message | .[0:80])"' <<<"$1"; } # queued-json

keep_for_retry() { # queued-json error → the post for the next flush, or nothing once MAX_POST_ATTEMPTS failed
  local attempts; attempts="$(jq '.attempts + 1' <<<"$1")"
  if (( attempts >= MAX_POST_ATTEMPTS )); then
    log_line "post lost on $(post_preview "$1") after $attempts attempts — $2"; return
  fi
  log_line "post unconfirmed on $(post_preview "$1") (attempt $attempts of $MAX_POST_ATTEMPTS) — $2"
  jq -c --argjson attempts "$attempts" '.attempts = $attempts' <<<"$1"
}

requeue() { # unconfirmed-json-lines flushed-count — the unconfirmed go first, then whatever was queued meanwhile
  local later; later="$(tail -n +"$(( $2 + 1 ))" "$SEND_QUEUE")"
  printf '%s' "${1:+$1
}${later:+$later
}" > "$SEND_QUEUE"
}

flush_posts() { # one relay of at most FLUSH_MAX_POSTS; a post leaves the queue only once Slack confirmed it → 1 while any is unconfirmed
  [ -s "$SEND_QUEUE" ] || return 0
  local batch paired item kept unconfirmed=""
  batch="$(head -n "$FLUSH_MAX_POSTS" "$SEND_QUEUE")"
  paired="$(connector_calls "$(send_calls_of <<<"$batch")" ordered)"
  while IFS= read -r item; do
    post_landed "$item" "$paired" && continue
    kept="$(keep_for_retry "$item" "$POST_ERROR")"
    [ -n "$kept" ] && unconfirmed="${unconfirmed:+$unconfirmed
}$kept"
  done <<<"$batch"
  requeue "$unconfirmed" "$(wc -l <<<"$batch")"
  [ -z "$unconfirmed" ]
}

as_code_block() { printf '```\n%s\n```' "$1"; }

post_code_block() { # subject multiline-text [poster] — chunked, or Slack splits the post itself and the fragments' ts go unrecorded
  local line chunk="" poster="${3:-post_to_thread}"
  while IFS= read -r line; do
    if [ -n "$chunk" ] && [ $(( ${#chunk} + ${#line} )) -gt "$CODE_BLOCK_MAX_CHARS" ]; then
      "$poster" "$1" "$(as_code_block "$chunk")"
      chunk=""
    fi
    chunk="${chunk:+$chunk
}$line"
  done <<<"$2"
  [ -n "$chunk" ] && "$poster" "$1" "$(as_code_block "$chunk")"
}

is_top_level_line() { [[ "$1" == *"$TOP_LEVEL_TAG" ]]; }

poster_for() { # subject recv-line — a [top] line goes to the top level of a Slack channel this channel owns; everything else to the thread
  is_top_level_line "$2" && has_own_slack_channel "$1" && echo post_top_level || echo post_to_thread
}

queue_new_channel_lines() { # subject — every line peers wrote since the bridge last read
  local message
  while IFS= read -r message; do
    post_code_block "$1" "$message" "$(poster_for "$1" "$message")"
  done < <("$TEAMUP" recv "$1" --as "$HANDLE" | sed 1d | grep '^  #')
}

# --- the thread: one per channel name, adopted again after a bridge restart ---

root_text_prefix() { printf '*teamup · %s* ' "$1"; }

agent_handles_or_none() { agent_handles "$1" | head -1; }

channel_gist() { # subject — what the channel is for: its --gist, else the opener's --doing
  cat "$BASE/$1/.gist" 2>/dev/null ||
    sed -n 's/^doing=//p' "$BASE/$1/members/$(agent_handles_or_none "$1")" 2>/dev/null
}

thread_root_text() { # subject — markdown bold, which the connector stores as Slack's *bold*
  local gist; gist="$(channel_gist "$1")"
  printf '**teamup · %s** — %s' "$1" "${gist:0:GIST_MAX_CHARS}"
}

read_channel_args() { # channel oldest
  jq -nc --arg channel "$1" --arg oldest "$2" '{channel_id: $channel, oldest: $oldest, response_format: "detailed"}'
}

read_thread_args() { # channel root oldest
  jq -nc --arg channel "$1" --arg root "$2" --arg oldest "$3" '{channel_id: $channel, message_ts: $root, oldest: $oldest, response_format: "detailed"}'
}

find_existing_root() { # subject — the thread this channel name already has today (a bridge restart); older ones are reused names
  local history
  history="$(connector_call slack_read_channel "$(read_channel_args "$(slack_channel_of "$1")" "$(( $(date +%s) - ADOPTABLE_ROOT_MAX_AGE_SECONDS ))")")" || return 1
  connector_messages_json "$(messages_text_of "$history")" |
    jq -r --arg prefix "$(root_text_prefix "$1")" \
      '[.messages[] | select(.text | startswith($prefix))] | sort_by(.ts | tonumber) | last | .ts // empty'
}

start_relaying_from_now() { # subject — an adopted thread's older replies were handled by the bridge that opened it
  echo "$(date +%s).000000" >> "$(relayed_file "$1")"
}

adopt_existing_thread() { # subject
  local root; root="$(find_existing_root "$1")"
  [ -n "$root" ] || return 1
  printf '%s' "$root" > "$(thread_file "$1")"
  start_relaying_from_now "$1"
}

open_new_thread() { # subject
  local root; root="$(send_now "$(slack_channel_of "$1")" "$(thread_root_text "$1")")"
  [ -n "$root" ] || die "could not open a Slack thread for '$1' — the connector did not answer"
  printf '%s' "$root" > "$(thread_file "$1")"
  record_posted "$1" "$root"
  post_code_block "$1" "$("$TEAMUP" peek "$1" --last "$BACKFILL_LINES")"
}

open_thread() { # subject
  [ -f "$(thread_file "$1")" ] && return 0
  adopt_existing_thread "$1" || open_new_thread "$1"
}

announce_thread_url() { # subject — once per channel, so agents never hunt for the permalink; waits until a post revealed the team URL
  [ -f "$(url_file "$1")" ] && return 0
  local root; root="$(cat "$(thread_file "$1")" 2>/dev/null)"
  [ -n "$root" ] && [ -n "$SLACK_TEAM_URL" ] || return 0
  printf '%sarchives/%s/p%s\n' "$SLACK_TEAM_URL" "$(slack_channel_of "$1")" "${root/./}" > "$(url_file "$1")"
  "$TEAMUP" note "$1" --as "$HANDLE" -- "mirror thread in Slack: $(cat "$(url_file "$1")") (also in $(url_file "$1"))" >/dev/null
}

# --- inbound: one relay per poll reads every mirrored thread (and the top level of channels that own one) ---

newest_known_reply() { # subject root — replies older than this minus a margin were already handled
  local newest
  newest="$(cat "$(posted_file "$1")" "$(relayed_file "$1")" 2>/dev/null | sort -n | tail -1)"
  awk -v ts="${newest:-$2}" -v margin="$LATE_REPLY_MARGIN_SECONDS" 'BEGIN { printf "%.6f", ts - margin }'
}

read_calls_for() { # subject root → the connector calls that fetch what this channel has not seen
  local channel oldest; channel="$(slack_channel_of "$1")"; oldest="$(newest_known_reply "$1" "$2")"
  jq -nc --arg name slack_read_thread --argjson args "$(read_thread_args "$channel" "$2" "$oldest")" '{name: $name, arguments: $args}'
  has_own_slack_channel "$1" || return 0
  jq -nc --arg name slack_read_channel --argjson args "$(read_channel_args "$channel" "$oldest")" '{name: $name, arguments: $args}'
}

replies_from_results() { # subject root paired-json → {ok, messages} merged from the thread and, for an owned channel, its top level
  local thread_text channel_text=""
  thread_text="$(result_of "$3" slack_read_thread "$(read_thread_args "$(slack_channel_of "$1")" "$2" "$(newest_known_reply "$1" "$2")")" 2>/dev/null)" ||
    { connector_failure_json "no thread result"; return; }
  if has_own_slack_channel "$1"; then
    channel_text="$(result_of "$3" slack_read_channel "$(read_channel_args "$(slack_channel_of "$1")" "$(newest_known_reply "$1" "$2")")" 2>/dev/null)" ||
      { connector_failure_json "no channel result"; return; }
  fi
  jq -s '{ok: true, messages: (map(.messages) | add | unique_by(.ts))}' \
    <(connector_messages_json "$(messages_text_of "$thread_text")" "$2") \
    <(connector_messages_json "$(messages_text_of "$channel_text")")
}

report_broken_session() { # subject error
  [ -f "$(broken_file "$1")" ] && return 0
  printf '%s' "$2" > "$(broken_file "$1")"
  post_to_thread "$1" ":warning: the Slack connector relay is failing ($2) — replies in this thread are NOT reaching the agents." || true
  "$TEAMUP" note "$1" --as "$HANDLE" -- "teamup-slack bridge is down ($2) — David is not receiving this channel and his replies are not arriving." || true
}

report_session_recovered() { # subject
  [ -f "$(broken_file "$1")" ] || return 0
  rm -f "$(broken_file "$1")"
  post_to_thread "$1" ":white_check_mark: the Slack connector relay is back — replies in this thread reach the agents again." || true
  "$TEAMUP" note "$1" --as "$HANDLE" -- "teamup-slack bridge is back up — David's replies are arriving again." || true
}

relay_down_too_long() { # sets FAILING_SINCE
  FAILING_SINCE="${FAILING_SINCE:-$SECONDS}"
  (( SECONDS - FAILING_SINCE >= REPORT_DOWN_AFTER_SECONDS ))
}

deliver_replies_of() { # subject paired-json
  local root replies
  root="$(cat "$(thread_file "$1")")"
  replies="$(replies_from_results "$1" "$root" "$2")"
  if [ "$(jq -r '.ok' <<<"$replies")" != true ]; then
    relay_down_too_long && report_broken_session "$1" "$(jq -r '.error' <<<"$replies")"
    return 1
  fi
  report_session_recovered "$1"
  deliver_unseen_replies "$1" "$root" "$replies"
}

poll_slack_once() {
  local subjects calls paired subject all_ok=1
  subjects="$(mirrored_channels_with_threads)"
  [ -n "$subjects" ] || return 0
  calls="$(for subject in $subjects; do read_calls_for "$subject" "$(cat "$(thread_file "$subject")")"; done | jq -sc .)"
  paired="$(connector_calls "$calls")"
  for subject in $subjects; do deliver_replies_of "$subject" "$paired" || all_ok=0; done
  [ "$all_ok" = 1 ] && FAILING_SINCE=""
}

# --- the daemon ---

mirrored_channels() { # every channel with a mirror marker whose dir still exists
  local marker
  for marker in "$BASE"/*/.slack.on; do [ -f "$marker" ] && basename "$(dirname "$marker")"; done
}

mirrored_channels_with_threads() {
  local subject
  for subject in $(mirrored_channels); do [ -f "$(thread_file "$subject")" ] && echo "$subject"; done
}

agents_remain() { # subject
  ls -A "$BASE/$1/members" 2>/dev/null | grep -qv "^$HANDLE$"
}

channel_stayed_empty() { # subject
  agents_remain "$1" && { rm -f "$(empty_since_file "$1")"; return 1; }
  [ -f "$(empty_since_file "$1")" ] || date +%s > "$(empty_since_file "$1")"
  (( $(date +%s) - $(cat "$(empty_since_file "$1")") >= RETIRE_AFTER_EMPTY_SECONDS ))
}

retire_mirror() { # subject
  post_to_thread "$1" "_channel is empty — mirror stopped. Replies here are delivered when an agent next joins \`$1\`._" || true
  "$TEAMUP" leave "$1" --as "$HANDLE" >/dev/null 2>&1 || true
  rm -f "$(mirror_marker "$1")" "$(empty_since_file "$1")"
}

retire_empty_channels() {
  local subject
  for subject in $(mirrored_channels); do channel_stayed_empty "$subject" && retire_mirror "$subject"; done
}

mirror_outbound_once() {
  local subject
  for subject in $(mirrored_channels); do
    queue_new_channel_lines "$subject"
    announce_thread_url "$subject"
  done
  flush_posts
}

run_daemon() {
  load_connector_identity
  trap 'exit 0' TERM INT
  local until_poll=0
  while true; do
    mirror_outbound_once
    if (( until_poll <= 0 )); then poll_slack_once; flush_posts; until_poll="$INBOUND_POLL_SECONDS"; fi
    retire_empty_channels
    sleep "$OUTBOUND_TICK_SECONDS"
    until_poll=$(( until_poll - OUTBOUND_TICK_SECONDS ))
  done
}

daemon_pid() { cat "$DAEMON_PID_FILE" 2>/dev/null; }
daemon_is_alive() { local pid; pid="$(daemon_pid)"; [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; }

stop_legacy_poller_of() { # subject — a per-channel poller from before the daemon, still holding the channel's old pidfile
  local pid
  for pid in $(pgrep -f "teamup-slack __run $1\$" 2>/dev/null); do pkill -P "$pid" 2>/dev/null; kill "$pid" 2>/dev/null; done
  rm -f "$BASE/$1/.slack.pid"
}

ensure_daemon() {
  daemon_is_alive && return 0
  nohup "$0" __daemon >> "$DAEMON_LOG" 2>&1 &
  echo $! > "$DAEMON_PID_FILE"
}

stop_daemon() {
  daemon_is_alive && kill "$(daemon_pid)" 2>/dev/null
  rm -f "$DAEMON_PID_FILE"
}

# --- the CLI ---

is_mirrored() { [ -f "$(mirror_marker "$1")" ] && daemon_is_alive; }

start_mirror() { # subject
  [ -d "$BASE/$1" ] || die "no such channel '$1' — teamup channels lists the live ones"
  is_slack_off_on_this_machine && { echo "Slack is off on this machine ($MACHINE_CONFIG)."; return 0; }
  is_slack_opted_out "$1" && { echo "'$1' opted out of Slack (join --no-slack)."; return 0; }
  is_mirrored "$1" && { echo "'$1' is already mirrored (daemon pid $(daemon_pid))."; return 0; }
  load_connector_identity
  stop_legacy_poller_of "$1"
  "$TEAMUP" join "$1" --as "$HANDLE" --pwd "slack-bridge" --doing "watching from Slack" >/dev/null
  open_thread "$1"
  flush_posts
  announce_thread_url "$1"
  touch "$(mirror_marker "$1")"
  ensure_daemon
  echo "mirroring '$1' to Slack (daemon pid $(daemon_pid)); log: $DAEMON_LOG"
}

stop_mirror() { # subject
  stop_legacy_poller_of "$1"
  rm -f "$(mirror_marker "$1")" "$(empty_since_file "$1")"
  "$TEAMUP" leave "$1" --as "$HANDLE" >/dev/null 2>&1 || true
  echo "stopped mirroring '$1'."
}

live_channels() { "$TEAMUP" channels | awk 'NF && $1 != "(none)" { print $1 }'; }

for_each_channel() { # action [subject]
  [ -n "${2:-}" ] && { "$1" "$2"; return; }
  local subject
  for subject in $(live_channels); do "$1" "$subject"; done
}

print_status() {
  local subject
  daemon_is_alive && echo "bridge daemon: pid $(daemon_pid), log $DAEMON_LOG" || echo "bridge daemon: not running"
  for subject in $(live_channels); do
    is_mirrored "$subject" &&
      printf '  %s — mirrored (thread %s)\n' "$subject" "$(cat "$(thread_file "$subject")" 2>/dev/null)" ||
      printf '  %s — not mirrored\n' "$subject"
  done
}

print_url() { # subject
  load_connector_identity
  announce_thread_url "$1"
  cat "$(url_file "$1")" 2>/dev/null || die "no thread URL for '$1' yet — the team URL is learned from the first post"
}

[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

case "${1:-}" in
  on)       for_each_channel start_mirror "${2:-}" ;;
  off)      for_each_channel stop_mirror "${2:-}"; [ -n "${2:-}" ] || stop_daemon ;;
  status)   print_status ;;
  url)      [ -n "${2:-}" ] || die "usage: teamup-slack url <subject>"; print_url "$2" ;;
  auto)     [ "${TEAMUP_SLACK:-on}" = off ] && exit 0
            is_mirrored "$2" && exit 0
            start_mirror "$2" >/dev/null 2>&1 || true ;;
  __daemon) run_daemon ;;
  *) echo "usage: teamup-slack on|off [subject] | status | url <subject>" >&2; exit 2 ;;
esac
