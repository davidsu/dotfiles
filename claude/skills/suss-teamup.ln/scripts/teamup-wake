#!/usr/bin/env bash
# teamup-wake <handle|session-id> [--channel C] [--role ROLE] [--color COLOR] [--after HANDLE] — resume a sleeping claude agent
# in a new iTerm tab, in its own directory, and have it rejoin its channel. The tab lands immediately right
# of the caller's own tab (the tab this command runs in, $ITERM_SESSION_ID), or of --after HANDLE's tab
# (env TEAMUP_AFTER_HANDLE). Prints what is waiting
# for it there, then once it is back: post its brief BEFORE waking it, it sees the brief on rejoin.
# Its tab and /color get --color, else its --role's color, else the color it had before it slept.
# teamup-wake --list — every agent that can be woken.
# teamup-wake --asleep <handle> — exit 0 if that agent can be woken.
set -uo pipefail

readonly HERE="$(cd "$(dirname "$0")" && pwd)"
readonly BASE="${SUSS_TEAMUP_DIR:-/tmp/suss-teamup}"
readonly PARKED="${XDG_STATE_HOME:-$HOME/.local/state}/suss-teamup/parked.tsv"
readonly SLEEPING="${XDG_STATE_HOME:-$HOME/.local/state}/suss-teamup/sleeping"
readonly REGISTRY="$BASE/.sessions.tsv"
readonly REJOIN_TIMEOUT_SECONDS=180

source "$HERE/session_colors.sh"

die() { echo "teamup-wake: $*" >&2; exit 1; }

is_session_running() { # session id — a session must never run twice
  local record
  for record in "$HOME"/.claude/sessions/*.json; do
    [ "$(jq -r '.sessionId // empty' "$record" 2>/dev/null)" = "$1" ] &&
      kill -0 "$(basename "$record" .json)" 2>/dev/null && return 0
  done
  return 1
}

is_claude_session() { compgen -G "$HOME/.claude/projects/*/$1.jsonl" >/dev/null; }

parked_record() { awk -F'\t' -v h="$1" '$1==h || $2==h' "$PARKED" 2>/dev/null | tail -1; }

registry_record() { # handle — a crashed session never left, so only the registry knows it
  awk -F'\t' -v h="$1" '($3==h || $4==h) && $4!="" { print $3 "\t" $4 "\t" $1 "\t" $2 "\t" "crashed?" }' "$REGISTRY" 2>/dev/null | tail -1
}

wake_record() { local record; record="$(parked_record "$1")"; printf '%s' "${record:-$(registry_record "$1")}"; }

sleep_reason_of() { # handle — the why and wakes-on it gave teamup-sleep
  [ -f "$SLEEPING/$1" ] || return 0
  awk -F= '$1=="why" { why=substr($0, 5) } $1=="wakes_on" { on=substr($0, 10) } END { printf "      💤 %s · wakes on: %s\n", why, on }' "$SLEEPING/$1"
}

list_asleep() {
  local handle session_id found=""
  while IFS=$'\t' read -r handle session_id _; do
    is_claude_session "$session_id" && ! is_session_running "$session_id" || continue
    found=yes
    wake_record "$handle" | awk -F'\t' '{ printf "  %-22s %s  in %s  (left %s)\n", $1, $4, $3, $5 }'
    sleep_reason_of "$handle"
  done < <({ cat "$PARKED" 2>/dev/null; awk -F'\t' '$4!="" { print $3 "\t" $4 }' "$REGISTRY" 2>/dev/null; } | sort -u -t$'\t' -k1,1)
  [ -n "$found" ] || echo "nobody is asleep."
}

can_wake() { # handle
  local session_id
  IFS=$'\t' read -r _ session_id _ <<<"$(wake_record "$1")"
  [ -n "$session_id" ] && is_claude_session "$session_id" && ! is_session_running "$session_id"
}

print_waiting_messages() { # handle channel
  local summary; summary="$("$HERE/teamup" status "$2" --as "$1" 2>/dev/null)"
  summary="${summary#summary: }"
  echo "waiting for $1 on '$2': ${summary%% listener=*}"
}

wait_for_join_ping() { # channel handle after-line
  for _ in $(seq 1 "$REJOIN_TIMEOUT_SECONDS"); do
    awk -F'\t' -v h="$2" -v after="$3" 'NR > after && $2==h && $3=="ping" { found=1 } END { exit !found }' \
      "$BASE/$1/channel.tsv" 2>/dev/null && return 0
    sleep 1
  done
  return 1
}

resume_command() { echo "cyc --resume $1${2:+ -- '/suss-teamup $2'}"; }

wake_color() { # role session-id
  if [ -n "$1" ]; then role_color "$1"; else transcript_color "$2"; fi
}

wake() { # handle channel color role after
  local record session_id dir channels channel tab log_lines color after="$5"
  record="$(wake_record "$1")"
  [ -n "$record" ] || die "nobody called '$1' can be woken (teamup-wake --list)"
  IFS=$'\t' read -r _ session_id dir channels _ <<<"$record"
  is_claude_session "$session_id" || die "'$1' is not a claude session: only claude agents can be woken"
  channel="${2:-${channels%%,*}}"
  is_session_running "$session_id" && die "'$1' is already running (session $session_id): find its tab instead"
  color="${3:-$(wake_color "$4" "$session_id")}"
  log_lines="$(wc -l < "$BASE/$channel/channel.tsv" 2>/dev/null || echo 0)"
  [ -z "$channel" ] || print_waiting_messages "$1" "$channel"
  tab="$(term_spawn --app iterm --dir "$dir" --run "$(resume_command "$session_id" "$channel")" ${after:+--after "$after"} --background)"
  echo "waking $1 in $dir (session $session_id)${channel:+ to rejoin '$channel'}..."
  sleep_reason_of "$1"
  rm -f "$SLEEPING/$1"
  [ -z "$color" ] || "$HERE/teamup-spawn" __boot_iterm "$tab" claude "$color" ||
    die "$1 did not come up: look at its tab, usually a permission prompt the resumed session is stuck on"
  [ -n "$channel" ] || { echo "$1 is back (it was on no channel)."; return 0; }
  wait_for_join_ping "$channel" "$1" "$log_lines" && echo "$1 is back on '$channel'." ||
    die "$1 did not rejoin '$channel' within ${REJOIN_TIMEOUT_SECONDS}s: look at its tab, usually a permission prompt the resumed session is stuck on"
}

case "${1:-}" in
  ""|-h|--help) echo "usage: teamup-wake <handle> [--channel C] [--role lead|owner|keeper|ROLE] [--color COLOR] [--after HANDLE] | --list | --asleep <handle>" >&2; exit 2 ;;
  --list) list_asleep; exit 0 ;;
  --asleep) can_wake "${2:-}"; exit ;;
esac
handle="$1"; shift; channel=""; color=""; role=""; after="${TEAMUP_AFTER_HANDLE:-${ITERM_SESSION_ID:-}}"; after="${after#*:}"
while [ $# -gt 0 ]; do
  case "$1" in
    --channel) channel="$2"; shift 2 ;;
    --role)    role="$2"; shift 2 ;;
    --color)   color="$2"; shift 2 ;;
    --after)   after="$2"; shift 2 ;;
    *) die "unknown flag $1" ;;
  esac
done
[ -z "$color" ] || is_session_color "$color" || die "--color must be one of: ${SESSION_COLORS[*]}"
wake "$handle" "$channel" "$color" "$role" "$after"
