#!/usr/bin/env bash
# teamup-sleep [--force|--force-with-no-mercy] --why R --wakes-on W [<handle|session-id>...] — put agents to sleep (no argument: the claude session running it): say why and what wakes it, hang up each one's claude, leave its channels, close its iTerm tab.
# `leave` records how to resume it, so `teamup-wake <handle>` brings it back later.
# Before running this, the agent has said "ready to sleep": its work is pushed and its
# browser tabs are closed (resources/agent_lifecycle.md).
set -uo pipefail

readonly HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly TEAMUP="$HERE/teamup"
readonly BASE="${SUSS_TEAMUP_DIR:-/tmp/suss-teamup}"
readonly REGISTRY="$BASE/.sessions.tsv"
readonly PARKED="${XDG_STATE_HOME:-$HOME/.local/state}/suss-teamup/parked.tsv"
readonly SLEEPING="${XDG_STATE_HOME:-$HOME/.local/state}/suss-teamup/sleeping"
readonly SESSION_ID_PATTERN='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
readonly QUIET_SECONDS=60
readonly DAVID_QUIET_SECONDS=300
readonly STOP_TIMEOUT_SECONDS=20

close_iterm_tab() { # handle tty — the tab on that tty, else the one claude titled "<handle> (claude)" after an optional status glyph
  osascript - "$1 (claude)" "${2:-}" <<'OSA'
on run argv
  set wanted to item 1 of argv
  set wantedTty to item 2 of argv
  tell application "iTerm2"
    repeat with w in (get windows)
      repeat with t in (get tabs of w)
        repeat with s in (get sessions of t)
          try
            set tabName to name of s
            set tabTty to tty of s
          on error
            set tabName to ""
            set tabTty to ""
          end try
          if (wantedTty is not "" and tabTty is wantedTty) or tabName is wanted or tabName ends with (" " & wanted) then
            close s
            return "closed"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return "none"
end run
OSA
}

channels_of() { compgen -G "$BASE/*/members/$1" | awk -F/ '{ print $(NF-2) }'; }

last_words() { # handle channel — its latest message, and how many seconds ago
  awk -F'\t' -v h="$1" '$2==h && ($3=="say"||$3=="ask"||$3=="ack") { at=$1; said=$4 } END { if (at) print at "\t" said }' \
    "$BASE/$2/channel.tsv"
}

seconds_since() { local at="${1%.*}"; echo $(( $(date -u +%s) - $(date -u -j -f '%Y-%m-%dT%H:%M:%S' "${at%Z}" +%s) )); }

focused_tab_name() {
  osascript -e 'tell application "iTerm2" to name of current session of current window' 2>/dev/null
}

seconds_since_input() { ioreg -c IOHIDSystem | awk '/HIDIdleTime/ { print int($NF / 1000000000); exit }'; }

is_david_at_the_mac() { [ "$(seconds_since_input)" -lt 120 ]; }

is_focused() { # handle — David is looking at its tab right now (while he is away, teamup-focus put it there)
  local wanted="$1 (claude)" tab; tab="$(focused_tab_name)"
  is_david_at_the_mac && { [ "$tab" = "$wanted" ] || [[ "$tab" == *" $wanted" ]]; }
}

running_session_field() { # key value field — a field of the claude session whose key (sessionId|name) is value, from ~/.claude/sessions
  jq -r --arg key "$1" --arg value "$2" --arg field "$3" 'select(.[$key] == $value) | .[$field] // empty' \
    "$HOME/.claude/sessions"/*.json 2>/dev/null | tail -1
}

registered_session_id() { awk -F'\t' -v h="$1" '$3==h && $4!="" { sid=$4 } END { print sid }' "$REGISTRY" 2>/dev/null; }

registered_handle() { awk -F'\t' -v s="$1" '$4==s { h=$3 } END { print h }' "$REGISTRY" 2>/dev/null; }

session_id_of() { # handle — a session on no channel is only known to claude, by its session name
  local session_id; session_id="$(registered_session_id "$1")"
  printf '%s' "${session_id:-$(running_session_field name "$1" sessionId)}"
}

handle_of() { # handle or session id — the name teamup and the tab title know the session by
  [[ "$1" =~ $SESSION_ID_PATTERN ]] || { printf '%s' "$1"; return; }
  local handle; handle="$(registered_handle "$1")"
  printf '%s' "${handle:-$(running_session_field sessionId "$1" name)}"
}

park_unregistered() { # handle — no channel means no registry row for leave to park, so teamup-wake could not find it
  [ -z "$(registered_session_id "$1")" ] || return 0
  local session_id; session_id="$(session_id_of "$1")"
  [ -n "$session_id" ] || return 0
  mkdir -p "$(dirname "$PARKED")"
  printf '%s\t%s\t%s\t\t%s\n' "$1" "$session_id" "$(running_session_field sessionId "$session_id" cwd)" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$PARKED"
}

transcript_of() { # handle — the claude transcript of its running session
  local session_id; session_id="$(session_id_of "$1")"
  [ -n "$session_id" ] && compgen -G "$HOME/.claude/projects/*/$session_id.jsonl" | head -1
}

claude_pid_of() { # handle — the pid of its running claude (~/.claude/sessions/{pid}.json names the session)
  local session_id; session_id="$(session_id_of "$1")"
  [ -n "$session_id" ] || return 0
  jq -r --arg sid "$session_id" 'select(.sessionId == $sid) | input_filename' "$HOME/.claude/sessions"/*.json 2>/dev/null |
    head -1 | xargs -I{} basename {} .json
}

hang_up_claude() { # pid — SIGHUP is what a tab close delivers: claude exits through its SessionEnd hooks
  kill -HUP "$1" 2>/dev/null || return 1
  for _ in $(seq 1 $((STOP_TIMEOUT_SECONDS * 10))); do
    kill -0 "$1" 2>/dev/null || return 0
    sleep 0.1
  done
  return 1
}

last_typed_prompt_at() { # handle — the last prompt David typed in its terminal; spawn/wake boots type /suss-teamup
  local transcript; transcript="$(transcript_of "$1")"
  [ -n "$transcript" ] || return 0
  jq -rR 'fromjson? | select(.type=="user" and .origin.kind=="human")
    | select((.message.content | if type=="string" then . else (.[0].text // "") end) | contains("<command-name>/suss-teamup") | not)
    | .timestamp' "$transcript" 2>/dev/null | tail -1
}

last_slack_dm_at() { # handle — David's last channel message naming it (@handle, ask --to); lines the bridge relayed from another machine's agent ("[handle] …") are not his
  local channel_log
  for channel_log in "$BASE"/*/channel.tsv; do
    awk -F'\t' -v mention="@$1" '$2=="david" && ($3=="say"||$3=="ask") && $4 !~ /^(@[^ ]+ )?\[[^] ]+\] / {
      rest = $4
      while ((i = index(rest, mention))) {
        rest = substr(rest, i + length(mention))
        if (rest !~ /^[A-Za-z0-9_-]/ && rest !~ /^\.[A-Za-z0-9]/) { print $1; break }
      }
    }' "$channel_log"
  done | sort | tail -1
}

is_david_message_recent() { # handle where at — prints it when it is within DAVID_QUIET_SECONDS
  [ -n "$3" ] && [ "$(seconds_since "$3")" -lt "$DAVID_QUIET_SECONDS" ] || return 1
  echo "  David messaged $1 $(seconds_since "$3")s ago ($2)"
}

david_spoke_lately() { # handle
  local spoke=1
  is_david_message_recent "$1" "typed in its terminal" "$(last_typed_prompt_at "$1")" && spoke=0
  is_david_message_recent "$1" "on a channel" "$(last_slack_dm_at "$1")" && spoke=0
  return $spoke
}

is_busy() { # handle — David spoke to it, someone is waiting on it, or it spoke a moment ago (maybe mid-push)
  local channel at said busy=1
  david_spoke_lately "$1" && busy=0
  for channel in $(channels_of "$1"); do
    "$TEAMUP" status "$channel" --as "$1" >/dev/null 2>&1
    [ $? -eq 2 ] && { echo "  $1 owes an answer on '$channel'"; busy=0; }
    IFS=$'\t' read -r at said <<<"$(last_words "$1" "$channel")"
    [ -n "$at" ] || continue
    echo "  last said on '$channel' ($(seconds_since "$at")s ago): ${said:0:160}"
    [ "$(seconds_since "$at")" -lt "$QUIET_SECONDS" ] && busy=0
  done
  return $busy
}

tty_of_pid() { local device; device="$(ps -o tty= -p "$1" 2>/dev/null | tr -d ' ')"; [ -n "$device" ] && [ "$device" != '??' ] && printf '/dev/%s' "$device"; }

stop_claude() { # handle pid — iTerm's close keeps the process alive for its undo window (~5 s): end it first, by pid
  hang_up_claude "$2" && echo "stopped $1 (claude pid $2)" ||
    echo "teamup-sleep: $1 (claude pid $2) did not exit within ${STOP_TIMEOUT_SECONDS}s" >&2
}

is_my_ancestor() { # pid — this script runs inside that process (an agent sleeping itself)
  local current=$$
  while [ "$current" -gt 1 ]; do
    [ "$current" = "$1" ] && return 0
    current="$(ps -o ppid= -p "$current" 2>/dev/null | tr -d ' ')"; [ -n "$current" ] || return 1
  done
  return 1
}

stop_leave_and_close() { # handle pid tty
  [ -z "$2" ] || stop_claude "$1" "$2"
  "$TEAMUP" leave --all --as "$1" | tail -1
  [ "$(close_iterm_tab "$1" "$3")" = closed ] && echo "closed the tab of $1" ||
    echo "teamup-sleep: no iTerm tab of $1; close it by hand" >&2
}

finish_detached() { # handle pid tty — in its own process group, so the agent's teardown cannot take it down with the tool that ran this
  bash -mc "nohup '$0' __finish '$1' '$2' '$3' >/dev/null 2>&1 &"
}

state_sleep_reason() { # handle why wakes-on — kept for teamup-wake --list, and said on every channel before the bye
  local channel
  mkdir -p "$SLEEPING"
  printf 'why=%s\nwakes_on=%s\nat=%s\n' "$2" "$3" "$(date -u +%FT%TZ)" > "$SLEEPING/$1"
  for channel in $(channels_of "$1"); do
    "$TEAMUP" note "$channel" --as "$1" -- "💤 sleeping: $2 · wakes on: $3" >/dev/null
  done
}

put_to_sleep() { # handle why wakes-on
  local pid tty=""; pid="$(claude_pid_of "$1")"
  state_sleep_reason "$1" "$2" "$3"
  [ -n "$pid" ] && tty="$(tty_of_pid "$pid")" ||
    echo "teamup-sleep: no running claude session registered for $1; only closing its tab" >&2
  park_unregistered "$1"
  if is_my_ancestor "$pid"; then
    finish_detached "$1" "$pid" "$tty"; echo "sleeping myself: $1 stops and its tab closes in a moment"
  else
    stop_leave_and_close "$1" "$pid" "$tty"
  fi
  echo "resume with: $HERE/teamup-wake $1"
}

# The tab David is typing in is never closed by --force or a self-sleep: an owner that slept
# itself with --force once cut David off mid-request. --force overrides only is_busy;
# --force-with-no-mercy, for a sleep David himself ordered, overrides both.
sleep_if_allowed() { # handle flag ('' | --force | --force-with-no-mercy) why wakes-on
  if is_focused "$1"; then
    [ "$2" = --force-with-no-mercy ] || {
      echo "teamup-sleep: not closing $1: David is in its tab right now (focused, typed within 120 s). Only --force-with-no-mercy overrides this, and only when David himself ordered the sleep." >&2
      return 1
    }
    echo "teamup-sleep: --force-with-no-mercy: closing $1 although David is in its tab" >&2
  fi
  if is_busy "$1"; then
    [ -n "$2" ] || {
      echo "teamup-sleep: not closing $1: it is busy (above). Ask it to say 'ready to sleep', or pass --force." >&2
      return 1
    }
    echo "teamup-sleep: $2: closing $1 although it is busy (above)" >&2
  fi
  put_to_sleep "$1" "${3:-}" "${4:-}"
}

[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

[ "${1:-}" = __finish ] && { stop_leave_and_close "$2" "$3" "$4"; exit 0; }

readonly USAGE="usage: teamup-sleep [--force|--force-with-no-mercy] --why '<reason>' --wakes-on '<what wakes it>' [<handle|session-id>...]  (none: this claude session; --force-with-no-mercy only when David himself ordered the sleep)
Every sleep says why and what wakes it (David 2026-10-31), e.g. --why 'au1 blocked: no Brave repro here' --wakes-on 'David picks a/b/c',
or --wakes-on 'review of #123' | 'Gabi answers in Slack' | 'PR #456 merged' | 'a free emulator slot'."
flag="" why="" wakes_on=""
while [ $# -gt 0 ]; do
  case "$1" in
    --force|--force-with-no-mercy) flag="$1"; shift ;;
    --why)      why="${2:-}"; shift 2 ;;
    --wakes-on) wakes_on="${2:-}"; shift 2 ;;
    *) break ;;
  esac
done
[ -n "$why" ] && [ -n "$wakes_on" ] || { echo "$USAGE" >&2; exit 2; }
[ $# -gt 0 ] || set -- ${CLAUDE_CODE_SESSION_ID:-}
[ $# -gt 0 ] || { echo "$USAGE" >&2; exit 2; }
status=0
for target in "$@"; do
  handle="$(handle_of "$target")"
  [ -n "$handle" ] || { echo "teamup-sleep: no claude session $target" >&2; status=1; continue; }
  sleep_if_allowed "$handle" "$flag" "$why" "$wakes_on" || status=1
done
exit "$status"
