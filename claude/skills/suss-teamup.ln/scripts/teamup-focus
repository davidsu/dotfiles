#!/usr/bin/env bash
# teamup-focus on [--skip HANDLE] | off | status — while the user is away, keep the screen on an
# agent's terminal. `on` starts one background poller; a second `on` changes nothing, so the user
# or any lead can run it at any time. Once the Mac has had no keyboard or mouse input for 2
# minutes, the screen is never more than 3 minutes without a claude iTerm tab in front. Worst
# case, counted from the last input: a tick lands just under the 2-minute gate, the next one acts
# 55 s later and finishes within its 5 s budget (measured ~1 s), so 120 + 55 + 5 = 180 s. A tick
# blocked by a hung iTerm (AppleEvent timeout, 2 min) is the one way past it. Every 55 s,
# unless a busy one already is, it brings forward the first claude tab whose title shows
# the busy spinner, else the tab of the live claude session that was active most recently
# (updatedAt in ~/.claude/sessions/*.json), re-selecting it each tick even when it is already in
# front, a no-op. It never picks Chrome: a Playwright tab keeps its tab
# group long after its agent stopped driving it. --skip leaves one agent's tab alone (a lead skips
# itself). It never launches iTerm2: while the app is not running a tick does nothing. A tab that
# closes mid-tick is skipped. Every tick while the user is away logs what it
# focused or kept to focus.log next to the pid file, and so does every osascript error.
# `on` and `off` run one at a time (a mkdir lock, broken after 10 s if its holder died), so any
# number of concurrent calls leaves exactly one poller, or none. `off` stops every poller, even
# ones not in the pid file. Backstop: a poller not named in the pid file quits before it acts.
set -uo pipefail

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/suss-teamup"
readonly PID_FILE="$STATE_DIR/focus.pid"
readonly LOG_FILE="$STATE_DIR/focus.log"
readonly LOCK_DIR="$STATE_DIR/focus.lock"
readonly STALE_LOCK_SECONDS=10
readonly CLAUDE_SESSIONS_DIR="$HOME/.claude/sessions"
readonly AWAY_SECONDS=120
readonly MAX_SECONDS_WITHOUT_WORKING_AGENT=180
readonly TICK_BUDGET_SECONDS=5
readonly POLL_SECONDS=$((MAX_SECONDS_WITHOUT_WORKING_AGENT - AWAY_SECONDS - TICK_BUDGET_SECONDS))

seconds_since_input() { ioreg -c IOHIDSystem | awk '/HIDIdleTime/ { print int($NF / 1000000000); exit }'; }

is_user_away() { [[ "$(seconds_since_input)" -ge "$AWAY_SECONDS" ]]; }

is_alive() { kill -0 "$1" 2>/dev/null; }

running_poller() { # prints its pid
  local pid; pid="$(cat "$PID_FILE" 2>/dev/null)"
  [[ -n "$pid" ]] && is_alive "$pid" && echo "$pid"
}

agents_most_recent_first() { # skipped handle; prints one live session name per line
  local session
  for session in "$CLAUDE_SESSIONS_DIR"/*.json; do
    jq -r --arg skipped "$1" \
      'select(.name and .name != $skipped) | "\(.updatedAt // 0) \(.pid) \(.name)"' "$session" 2>/dev/null
  done | sort -rn | while read -r _ pid name; do is_alive "$pid" && echo "$name"; done
}

focus_agent_terminal() { # skipped handle
  osascript - "$1" "$(agents_most_recent_first "$1")" <<'OSA'
on agentTitleSuffix(handle)
  return " " & handle & " (claude)"
end agentTitleSuffix

on isBusy(tabName)
  repeat with glyph in {"◐", "◓", "◑", "◒"}
    if tabName starts with glyph then return true
  end repeat
  return false
end isBusy

on busyAgentTabInFront()
  tell application "System Events" to set frontName to name of first process whose frontmost is true
  if frontName is not "iTerm2" then return ""
  tell application "iTerm2" to set frontTab to name of current session of current window
  if my isBusy(frontTab) then return frontTab
  return ""
end busyAgentTabInFront

on isWanted(tabName, wantedSuffix, skippedSuffix)
  if wantedSuffix is "" then return my isBusy(tabName) and tabName does not end with skippedSuffix
  return tabName ends with wantedSuffix
end isWanted

on nameOrBlank(s)
  try
    tell application "iTerm2" to return name of s
  on error
    return ""
  end try
end nameOrBlank

on focusFirstTab(wantedSuffix, skippedSuffix)
  tell application "iTerm2"
    repeat with w in (get windows)
      repeat with t in (get tabs of w)
        repeat with s in (get sessions of t)
          set tabName to my nameOrBlank(s)
          if my isWanted(tabName, wantedSuffix, skippedSuffix) then
            activate
            select w
            tell t to select
            tell s to select
            return tabName
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return ""
end focusFirstTab

on run argv
  if application "iTerm2" is not running then return "iTerm2 not running: left alone"
  set keptTab to busyAgentTabInFront()
  if keptTab is not "" then return "kept " & keptTab
  set skippedSuffix to agentTitleSuffix(item 1 of argv)
  set wantedSuffixes to {""}
  repeat with handle in paragraphs of (item 2 of argv)
    if handle as text is not "" then set end of wantedSuffixes to agentTitleSuffix(handle as text)
  end repeat
  repeat with wantedSuffix in wantedSuffixes
    set focusedTab to focusFirstTab(wantedSuffix as text, skippedSuffix)
    if focusedTab is not "" then return "focused " & focusedTab
  end repeat
  return "no claude tab to focus"
end run
OSA
}

log_line() { while read -r line; do [[ -n "$line" ]] && echo "$(date '+%F %T') $line"; done >> "$LOG_FILE"; }

is_the_one_poller() { [[ "$(cat "$PID_FILE" 2>/dev/null)" == "$$" ]]; }

poll() { # skipped handle
  while sleep "$POLL_SECONDS" && is_the_one_poller; do
    is_user_away && focus_agent_terminal "$1" 2>&1 | log_line
  done
}

lock_age_seconds() { echo $(( $(date +%s) - $(stat -f %m "$LOCK_DIR" 2>/dev/null || date +%s) )); }

with_lock() { # command...
  until mkdir "$LOCK_DIR" 2>/dev/null; do
    [[ "$(lock_age_seconds)" -gt "$STALE_LOCK_SECONDS" ]] && rmdir "$LOCK_DIR" 2>/dev/null
    sleep 0.05
  done
  trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT
  "$@"
}

start_poller() { # skipped handle
  local pid
  pid="$(running_poller)" && { echo "teamup-focus: already on (pid $pid)"; return; }
  nohup "$0" __poll "$1" >/dev/null 2>&1 &
  echo "$!" > "$PID_FILE"
  echo "teamup-focus: on (pid $!)${1:+, skipping $1}, log $LOG_FILE"
}

stop_pollers() {
  local count; count="$(pgrep -P 1 -f "teamup-focus __poll" | wc -l | tr -d ' ')"
  rm -f "$PID_FILE"
  pkill -f "teamup-focus __poll"
  echo "teamup-focus: off (stopped $count poller(s))"
}

turn_on() { mkdir -p "$STATE_DIR"; with_lock start_poller "$1"; }

turn_off() { mkdir -p "$STATE_DIR"; with_lock stop_pollers; }

case "${1:-}" in
  on)     if [[ "${2:-}" = --skip ]]; then turn_on "${3:-}"; else turn_on ""; fi ;;
  off)    turn_off ;;
  status) pid="$(running_poller)" && echo "teamup-focus: on (pid $pid)" || echo "teamup-focus: off" ;;
  __poll) poll "${2:-}" ;;
  *)      echo "usage: teamup-focus on [--skip HANDLE] | off | status" >&2; exit 2 ;;
esac
