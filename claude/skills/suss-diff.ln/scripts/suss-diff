#!/usr/bin/env bash
# suss-diff — open gdiffbranch in a new iTerm tab right of the caller's tab, and focus it.
#   suss-diff <worktree> [gdiffbranch args...]
set -euo pipefail

[[ $# -ge 1 ]] || { echo "usage: suss-diff <worktree> [gdiffbranch args...]" >&2; exit 1; }
worktree="$1"; shift
git -C "$worktree" rev-parse --is-inside-work-tree >/dev/null || { echo "suss-diff: $worktree is not a git worktree" >&2; exit 1; }

caller_session="${ITERM_SESSION_ID#*:}"
"$HOME/.dotfiles/bin/term_spawn" --app iterm --dir "$worktree" --run "gdiffbranch${*:+ $*}" \
  ${caller_session:+--after "$caller_session"}
