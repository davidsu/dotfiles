#!/usr/bin/env -S python3 -I
"""suss-telegram claim [<bot>] --as <handle> [--group <group>] [--inbox <channel>] | release --as <handle>
             | say --as <handle> -- <text> | status | setup <bot> | auto

David talks to his agents on Telegram. Each agent speaks through its own bot, in one of David's
groups. Bot tokens live in the login keychain (service suss-telegram, account = bot name); groups,
bots and who holds which live in ~/.local/share/suss-telegram/config.json.
A message from David reaches an agent's inbox channel (posted there as 'david') when it replies to
that agent's bubble, @mentions its bot, or mentions no bot at all (everyone in the group gets it).
"""
import functools
import html
import json
import os
import queue
import re
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path

TEAMUP = Path.home() / ".claude/skills/suss-teamup/scripts/teamup"
TEAMUP_BASE = Path(os.environ.get("SUSS_TEAMUP_DIR", "/tmp/suss-teamup"))
CONFIG = Path.home() / ".local/share/suss-telegram/config.json"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "suss-telegram"
PID = STATE / "daemon.pid"
LOG = STATE / "daemon.log"
MEDIA = STATE / "media"
KEYCHAIN_SERVICE = "suss-telegram"
WHISPER_MODEL = Path.home() / ".local/share/whisper/ggml-medium.bin"
ATTACHMENT_KINDS = ("photo", "voice", "audio", "video_note", "video", "document")
SPOKEN_ATTACHMENTS = ("voice", "audio", "video_note")
HUMAN = "david"
LONG_POLL_SECONDS = 10
SETUP_POLL_SECONDS = 30
SOCKET_SLACK_SECONDS = 5
SEND_TIMEOUT_SECONDS = 15
RETRY_DELAY_SECONDS = 1
BOT_CHECK_SECONDS = 5
MAX_TEXT_CHARS = 4000
QUOTE_CHARS = 80
BROADCAST_WAIT_SECONDS = 3
DECIDED_MEMORY_SECONDS = 120
LONG_PARAGRAPH_CHARS = 160
FILE_MARKER = re.compile(r"\[file: ([^\]]+)\]")
LINE_BREAK = "\\n"
NUMBERED_ITEM = re.compile(r"\s+(?=\(\d+\)\s)")
SENTENCE_BREAK = re.compile(r"(?<=[.!?:])\s+(?=\S)")
POST_ENV = {**{key: value for key, value in os.environ.items()
               if key not in ("CLAUDE_CODE_SESSION_ID", "TEAMUP_SESSION", "CODEX_THREAD_ID", "TEAMUP_SESSION_NAME")},
            "TEAMUP_SLACK": "off"}


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{threading.get_ident()}")
    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=1))
    temporary.replace(path)


def log(text):
    print(f"{time.strftime('%F %T')} {text}", flush=True)


CONFIG_LOCK = threading.Lock()


def config(): return read_json(CONFIG, {"groups": {}, "bots": {}})


def update_bot(bot, **fields):
    with CONFIG_LOCK:
        current = config()
        current["bots"][bot] = {key: value for key, value in {**current["bots"].get(bot, {}), **fields}.items()
                                if value is not None}
        write_json(CONFIG, current)
        CONFIG.chmod(0o600)


def bots(): return config()["bots"]


def chat_of(bot): return config()["groups"][bots()[bot]["group"]]


def bot_of(handle): return next((bot for bot, entry in bots().items() if entry.get("agent") == handle), None)


def held_bots(): return [bot for bot, entry in bots().items() if entry.get("agent")]


def free_pool_bots(): return sorted(bot for bot, entry in bots().items() if entry.get("pool") and not entry.get("agent"))


def bot_usernames(): return {entry["username"].lower(): bot for bot, entry in bots().items() if "username" in entry}


def names_of_bots():
    names = {}
    for bot, entry in bots().items():
        for name in (bot, entry.get("username"), entry.get("agent")):
            if name:
                names[name.lower()] = bot
    return names


@functools.cache
def token_of(bot):
    return subprocess.run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", bot, "-w"],
                          capture_output=True, text=True, check=True).stdout.strip()


def store_token(bot, token):
    command = f"add-generic-password -U -s {KEYCHAIN_SERVICE} -a {bot} -w {token}\n"
    subprocess.run(["security", "-i"], input=command, capture_output=True, text=True, check=True)


def bot_user_id(bot): return int(token_of(bot).split(":")[0])


def call_bot(request, socket_timeout=SEND_TIMEOUT_SECONDS):
    with urllib.request.urlopen(request, timeout=socket_timeout) as response:
        return json.load(response)["result"]


def telegram(bot, method, socket_timeout=SEND_TIMEOUT_SECONDS, **params):
    return call_bot(urllib.request.Request(f"https://api.telegram.org/bot{token_of(bot)}/{method}",
                                           data=json.dumps(params).encode(),
                                           headers={"Content-Type": "application/json"}), socket_timeout)


def form_field(boundary, name, value, filename=None):
    disposition = f'form-data; name="{name}"' + (f'; filename="{filename}"' if filename else "")
    return f"--{boundary}\r\nContent-Disposition: {disposition}\r\n\r\n".encode() + value + b"\r\n"


def send_document(bot, path):
    boundary = uuid.uuid4().hex
    body = (form_field(boundary, "chat_id", str(chat_of(bot)).encode())
            + form_field(boundary, "document", path.read_bytes(), path.name) + f"--{boundary}--\r\n".encode())
    return call_bot(urllib.request.Request(f"https://api.telegram.org/bot{token_of(bot)}/sendDocument", data=body,
                                           headers={"Content-Type": f"multipart/form-data; boundary={boundary}"}))


def send_files(bot, text):
    for path in map(Path, FILE_MARKER.findall(text)):
        try:
            send_document(bot, path)
        except (OSError, ValueError) as error:
            telegram(bot, "sendMessage", chat_id=chat_of(bot), text=f"(file not sent: {path}: {error})")


def lines_of(paragraph):
    return SENTENCE_BREAK.sub("\n", paragraph) if len(paragraph) > LONG_PARAGRAPH_CHARS else paragraph


def airy(text):
    paragraphs = NUMBERED_ITEM.sub("\n\n", text.replace(LINE_BREAK, "\n")).split("\n\n")
    return "\n\n".join(lines_of(paragraph.strip()) for paragraph in paragraphs)


def bubble_html(handle, text):
    return f"{html.escape(airy(text)[:MAX_TEXT_CHARS])}\n\n<b><i>agent: {html.escape(handle)}</i></b>"


def say(handle, text):
    bot = bot_of(handle) or sys.exit(f"'{handle}' holds no bot; run: suss-telegram claim --as {handle}")
    telegram(bot, "sendMessage", chat_id=chat_of(bot), parse_mode="HTML",
             text=bubble_html(handle, text))
    send_files(bot, text)


def offset_file(bot): return STATE / f"{bot}.offset"


def fetch_updates(bot, timeout):
    updates = telegram(bot, "getUpdates", socket_timeout=timeout + SOCKET_SLACK_SECONDS,
                       offset=int(read_json(offset_file(bot), 0)), timeout=timeout, allowed_updates=["message"])
    if updates:
        write_json(offset_file(bot), updates[-1]["update_id"] + 1)
    return [update["message"] for update in updates if "message" in update]


def mentioned_bots(message):
    text = message.get("text") or message.get("caption") or ""
    entities = message.get("entities") or message.get("caption_entities") or []
    usernames = bot_usernames()
    mentions = {text[entity["offset"] + 1:entity["offset"] + entity["length"]].lower()
                for entity in entities if entity["type"] == "mention"}
    return {usernames[mention] for mention in mentions if mention in usernames}


def prefixed_bot(message):
    first_word = (message.get("text") or message.get("caption") or "").split(maxsplit=1)[:1]
    return names_of_bots().get(first_word[0].strip("@:,").lower()) if first_word else None


def replied_bot_id(message):
    replied_to = message.get("reply_to_message", {}).get("from", {})
    return replied_to["id"] if replied_to.get("is_bot") else None


def is_listening(bot):
    entry = bots()[bot]
    return (TEAMUP_BASE / entry["inbox"] / "members" / entry["agent"]).exists()


def present_bots_in(chat_id):
    return {bot for bot in held_bots() if chat_of(bot) == chat_id and is_listening(bot)}


def first_word(message):
    words = (message.get("text") or message.get("caption") or "").split(maxsplit=1)
    return words[0].strip("@:,") if words else ""


def named_bots(message):
    return mentioned_bots(message) | {prefixed_bot(message)} - {None}


def is_from_david(bot, message):
    return message["chat"]["id"] == chat_of(bot) and message.get("from", {}).get("id") == config()["david_id"]


def attachment_of(message):
    kind = next((kind for kind in ATTACHMENT_KINDS if kind in message), None)
    if kind is None:
        return None, None
    file = message[kind][-1] if kind == "photo" else message[kind]
    return kind, file["file_id"]


def download(bot, file_id, message_id):
    remote_path = telegram(bot, "getFile", file_id=file_id)["file_path"]
    MEDIA.mkdir(parents=True, exist_ok=True)
    local_path = MEDIA / f"{bot}_{message_id}_{Path(remote_path).name}"
    urllib.request.urlretrieve(f"https://api.telegram.org/file/bot{token_of(bot)}/{remote_path}", local_path)
    return local_path


def transcribe(audio_path):
    wav_path = audio_path.with_suffix(".wav")
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(audio_path), "-ar", "16000", "-ac", "1", str(wav_path)],
                   check=True)
    whisper = subprocess.run(["whisper-cli", "-m", str(WHISPER_MODEL), "-l", "auto", "-nt", "-np", "-f", str(wav_path)],
                             capture_output=True, text=True)
    return whisper.stdout.strip() or f"(transcription failed: {whisper.stderr.strip()[-200:]})"


def quote_of(message):
    replied_to = message.get("reply_to_message")
    if not replied_to:
        return ""
    quoted = (replied_to.get("text") or replied_to.get("caption") or "").replace("\n", " ")[:QUOTE_CHARS]
    return f'(re: "{quoted}") '


def text_of(bot, message):
    kind, file_id = attachment_of(message)
    words = message.get("text") or message.get("caption") or ""
    if kind is None:
        return quote_of(message) + words.replace("\n", LINE_BREAK)
    saved = download(bot, file_id, message["message_id"])
    transcript = f" transcript: {transcribe(saved)}" if kind in SPOKEN_ATTACHMENTS else ""
    return quote_of(message) + f"{words} [{kind}: {saved}]{transcript}".strip().replace("\n", " ")


def react(bot, message, emoji):
    telegram(bot, "setMessageReaction", chat_id=message["chat"]["id"], message_id=message["message_id"],
             reaction=[{"type": "emoji", "emoji": emoji}])


def deliver(bot, message):
    entry = bots()[bot]
    posted = subprocess.run([str(TEAMUP), "say", entry["inbox"], "--as", HUMAN, "--", text_of(bot, message)],
                            env=POST_ENV, capture_output=True, text=True)
    react(bot, message, "👍" if posted.returncode == 0 else "👎")


def same_message_key(message):
    attachment = next((message[kind] for kind in ATTACHMENT_KINDS if kind in message), None)
    file_id = (attachment[-1] if isinstance(attachment, list) else attachment or {}).get("file_unique_id")
    return message["chat"]["id"], message["date"], message.get("text") or message.get("caption"), file_id


def say_not_here(bot, message):
    telegram(bot, "sendMessage", chat_id=message["chat"]["id"], reply_to_message_id=message["message_id"],
             text=f"{first_word(message) or 'They'} is not here.")


class Dispatcher:
    def __init__(self):
        self.waiting = {}
        self.decided = {}

    def take(self, bot, message):
        if not is_from_david(bot, message):
            return log(f"{bot}: dropped a message from chat {message['chat']['id']}")
        key = same_message_key(message)
        verdict = self.decided.get(key, (None,))[0]
        if verdict == "everyone":
            return run_guarded(deliver, bot, message)
        if verdict:
            return
        if replied := replied_bot_id(message):
            return self.decide_reply(key, bot, message, replied)
        if named := named_bots(message):
            return self.decide_named(key, bot, message, named)
        self.wait_for_siblings(key, bot, message)

    def decide_reply(self, key, bot, message, replied):
        if replied == bot_user_id(bot):
            self.settle(key, "reply")
            run_guarded(deliver, bot, message)

    def decide_named(self, key, bot, message, named):
        present = named & present_bots_in(message["chat"]["id"])
        if bot in present:
            run_guarded(deliver, bot, message)
        elif not present:
            self.settle(key, "absent")
            run_guarded(say_not_here, bot, message)

    def wait_for_siblings(self, key, bot, message):
        copies = self.waiting.setdefault(key, {"deadline": time.monotonic() + BROADCAST_WAIT_SECONDS, "copies": []})
        copies["copies"].append((bot, message))
        if {bot for bot, _ in copies["copies"]} >= present_bots_in(message["chat"]["id"]):
            self.deliver_to_everyone(key)

    def settle(self, key, verdict):
        self.waiting.pop(key, None)
        self.decided[key] = (verdict, time.monotonic())

    def deliver_to_everyone(self, key):
        copies = self.waiting[key]["copies"]
        self.settle(key, "everyone")
        for bot, message in copies:
            run_guarded(deliver, bot, message)

    def next_timeout(self):
        deadlines = [copies["deadline"] for copies in self.waiting.values()]
        return max(0, min(deadlines) - time.monotonic()) if deadlines else None

    def expire(self):
        now = time.monotonic()
        for key in [key for key, copies in self.waiting.items() if copies["deadline"] <= now]:
            self.deliver_to_everyone(key)
        self.decided = {key: value for key, value in self.decided.items() if now - value[1] < DECIDED_MEMORY_SECONDS}


def run_guarded(step, *args):
    try:
        step(*args)
    except TimeoutError:
        log(f"{step.__name__} timed out, retrying")
    except Exception as error:
        log(f"{step.__name__} failed: {error!r}")
        time.sleep(RETRY_DELAY_SECONDS)


def queue_messages(bot, deliveries):
    for message in fetch_updates(bot, LONG_POLL_SECONDS):
        deliveries.put((bot, message))


def receive_forever(bot, deliveries):
    while bot in held_bots():
        run_guarded(queue_messages, bot, deliveries)


def deliver_forever(deliveries):
    dispatcher = Dispatcher()
    while True:
        try:
            run_guarded(dispatcher.take, *deliveries.get(timeout=dispatcher.next_timeout()))
        except queue.Empty:
            pass
        dispatcher.expire()


def start_thread(loop, *args):
    thread = threading.Thread(target=loop, args=args, daemon=True)
    thread.start()
    return thread


def run_daemon():
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    log("daemon up")
    deliveries = queue.Queue()
    start_thread(deliver_forever, deliveries)
    pollers = {}
    while held := held_bots():
        for bot in held:
            if not (bot in pollers and pollers[bot].is_alive()):
                pollers[bot] = start_thread(receive_forever, bot, deliveries)
        time.sleep(BOT_CHECK_SECONDS)
    log("no bot is held, daemon down")


def daemon_pid():
    try:
        pid = int(PID.read_text())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def start_daemon():
    if daemon_pid():
        return
    STATE.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a") as log_file:
        process = subprocess.Popen([sys.executable, "-I", __file__, "__run"], stdout=log_file, stderr=log_file,
                                   stdin=subprocess.DEVNULL, start_new_session=True)
    PID.write_text(str(process.pid))


def is_in_group(bot, group):
    try:
        member = telegram(bot, "getChatMember", chat_id=config()["groups"][group], user_id=bot_user_id(bot))
    except urllib.error.HTTPError:
        return False
    return member["status"] in ("member", "administrator")


def pick_pool_bot(group):
    free = free_pool_bots()
    return next((bot for bot in free if is_in_group(bot, group)), next(iter(free), None))


def claim(bot, handle, group, inbox):
    if held := bot_of(handle):
        sys.exit(f"'{handle}' already holds bot '{held}'")
    group = group or (bot and bots()[bot].get("group")) or sys.exit(f"pass --group <{' | '.join(config()['groups'])}>")
    bot = bot or pick_pool_bot(group) or sys.exit("no free bot in the pool")
    if (holder := bots()[bot].get("agent")) and holder != handle:
        sys.exit(f"bot '{bot}' is held by '{holder}'")
    if not is_in_group(bot, group):
        sys.exit(f"NOT CLAIMED: bot '{bot}' is not in group '{group}'. Ask David to add "
                 f"@{bots()[bot]['username']} to '{group}' (Add Members), then claim again.")
    update_bot(bot, agent=handle, group=group, inbox=inbox or f"tg.{handle}")
    entry = bots()[bot]
    subprocess.run([str(TEAMUP), "join", entry["inbox"], "--as", handle, "--doing", "David's Telegram messages"],
                   env={**os.environ, "TEAMUP_SLACK": "off"}, capture_output=True)
    start_daemon()
    print(f"'{handle}' speaks as bot '{bot}' (@{entry['username']}) in group '{group}'; "
          f"David's messages land on channel '{entry['inbox']}'.")


def leave_group(bot): telegram(bot, "leaveChat", chat_id=chat_of(bot))


def release(handle):
    if not (bot := bot_of(handle)):
        return
    entry = bots()[bot]
    if entry.get("pool"):
        run_guarded(leave_group, bot)
    update_bot(bot, agent=None, inbox=None, group=None if entry.get("pool") else entry.get("group"))
    print(f"bot '{bot}' released by '{handle}'" + (f" and left group '{entry['group']}'." if entry.get("pool") else "."))


def token_from_stdin():
    print("Paste the bot token from @BotFather on stdin:", file=sys.stderr, flush=True)
    return sys.stdin.readline().strip()


def setup(bot):
    token = token_from_stdin()
    store_token(bot, token)
    token_of.cache_clear()
    username = telegram(bot, "getMe")["username"]
    update_bot(bot, username=username, pool=True)
    print(f"bot '{bot}' (@{username}) is in the pool; privacy mode must be off in @BotFather (/setprivacy).")


def print_status():
    pid = daemon_pid()
    print(f"  daemon: {f'running (pid {pid})' if pid else 'stopped'}; groups: {', '.join(config()['groups'])}")
    for bot, entry in sorted(bots().items()):
        holder = f"{entry['agent']} in {entry.get('group')}, inbox {entry.get('inbox')}" if entry.get("agent") else "free"
        print(f"  {bot:10} @{entry.get('username', '?'):28} {'pool ' if entry.get('pool') else 'owned'} {holder}")


def option(args, name):
    return args[args.index(name) + 1] if name in args else None


USAGE = __doc__.strip().split("\n\n")[0]

if __name__ == "__main__":
    command, args = (sys.argv[1] if len(sys.argv) > 1 else ""), sys.argv[2:]
    handle = option(args, "--as")
    if command == "claim" and handle:
        positional = args[0] if args and not args[0].startswith("--") else None
        claim(positional, handle, option(args, "--group"), option(args, "--inbox"))
    elif command == "release" and handle:
        release(handle)
    elif command == "say" and handle and "--" in args:
        say(handle, " ".join(args[args.index("--") + 1:]))
    elif command == "status":
        print_status()
    elif command == "setup" and len(args) == 1:
        setup(*args)
    elif command == "auto":
        if held_bots():
            start_daemon()
    elif command == "__run":
        run_daemon()
    else:
        sys.exit(f"usage: {USAGE}")
