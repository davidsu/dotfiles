#!/usr/bin/env bash
# iterm_float [--fraction F] COMMAND… — run a shell command in a floating, chromeless iTerm window centered on the screen
# (the "Agent Picker" dynamic profile, F of the visible screen, default 0.9; the window closes when the command ends).
# bin/claude_transcript_jump uses --fraction 1 (the whole visible screen).
# Karabiner's cmd+ctrl+{t,c,b} run `iterm_float mru|chromehistory|chromebookmarks`; bin/iterm_agent_picker uses it too.
# COMMAND is run by an interactive zsh, so aliases and the fzf functions from zsh/sources work.
# Singleton: while a floating window is open, another call brings it to the front instead (exit 3).
set -euo pipefail

readonly FLOAT_PROFILE="Agent Picker"
screen_fraction=0.9
[ "${1:-}" = --fraction ] && { screen_fraction="$2"; shift 2; }

[ $# -gt 0 ] || { echo "usage: iterm_float [--fraction F] COMMAND…" >&2; exit 1; }

outcome="$(osascript -l JavaScript - "$FLOAT_PROFILE" "$screen_fraction" "zsh -ic $(printf '%q' "$*")" <<'JXA'
ObjC.import('AppKit');
const coverScreenCenter = (window, fraction) => {
  const screen = $.NSScreen.mainScreen.frame.size;
  const visible = $.NSScreen.mainScreen.visibleFrame;
  const width = Math.round(visible.size.width * fraction);
  const height = Math.round(visible.size.height * fraction);
  const visibleTop = screen.height - (visible.origin.y + visible.size.height);
  window.bounds = {
    x: Math.round(visible.origin.x + (visible.size.width - width) / 2),
    y: Math.round(visibleTop + (visible.size.height - height) / 2),
    width,
    height,
  };
};
const existingFloatingWindow = (iterm, profile) =>
  iterm.windows().find((window) => window.currentSession().profileName() === profile);
function run([profile, fraction, command]) {
  const iterm = Application('iTerm2');
  const open = existingFloatingWindow(iterm, profile);
  if (open) {
    iterm.activate();
    open.select();
    return 'already open';
  }
  const window = iterm.createWindowWithProfile(profile, { command });
  iterm.activate();
  coverScreenCenter(window, Number(fraction));
  return 'opened';
}
JXA
)"
[ "$outcome" = opened ] || { echo "iterm_float: the floating window is already open, brought it to the front" >&2; exit 3; }
