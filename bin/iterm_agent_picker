#!/usr/bin/env bash
# iterm_agent_picker — cmd+ctrl+g: a floating iTerm window listing the live Claude agents in fzf.
# Each row is a colored block + the name in the agent's /color; the preview pane shows what is on that
# agent's tab right now (its iTerm screen). ctrl+j / ctrl+k move (fzf's defaults, like telescope), typing
# filters, Enter focuses that agent's tab (bin/iterm_focus_agent), Esc closes the window.
#   iterm_agent_picker                 open the floating window (the "Agent Picker" dynamic profile) running --pick
#   iterm_agent_picker --pick          the picker itself: what runs inside that window
#   iterm_agent_picker --preview TTY   print the screen of the iTerm session on TTY (fzf's preview command, bottom anchored)
set -euo pipefail
export PATH="/opt/homebrew/bin:$PATH"

readonly PICKER_PROFILE="Agent Picker"
readonly SELF="$(realpath "${BASH_SOURCE[0]}")"
readonly FOCUS_AGENT="$(dirname "$SELF")/iterm_focus_agent"
readonly ROW_MARK="■ "
source "$HOME/.claude/skills/suss-teamup/scripts/session_colors.sh"

open_picker_window() {
  osascript -l JavaScript - "$PICKER_PROFILE" "$SELF --pick" <<'JXA'
ObjC.import('AppKit');
const centerOnMainScreen = (window) => {
  const screen = $.NSScreen.mainScreen.frame.size;
  const { width, height } = window.bounds();
  window.bounds = { x: Math.round((screen.width - width) / 2), y: Math.round((screen.height - height) / 2), width, height };
};
function run([profile, command]) {
  const iterm = Application('iTerm2');
  const window = iterm.createWindowWithProfile(profile, { command });
  iterm.activate();
  centerOnMainScreen(window);
}
JXA
}

screen_of_tty() {
  osascript - "$1" <<'OSA'
on run argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (tty of s) is (item 1 of argv) then return contents of s
        end repeat
      end repeat
    end repeat
  end tell
  return "(not in an iTerm tab)"
end run
OSA
}

ansi_code_of() {
  case "$1" in
    red) echo 31 ;;
    green) echo 32 ;;
    yellow) echo 33 ;;
    blue) echo 34 ;;
    purple) echo 35 ;;
    cyan) echo 36 ;;
    orange) echo '38;5;208' ;;
    pink) echo '38;5;213' ;;
    *) echo 0 ;;
  esac
}

live_tty_of_pid() { ps -o tty= -p "$1" 2>/dev/null | tr -d ' ' | grep -v '^??$' || true; }

agent_rows() {
  local pid name session_id tty
  while IFS=$'\t' read -r pid name session_id; do
    tty="$(live_tty_of_pid "$pid")"
    [ -n "$tty" ] && printf '%s\t%s\t/dev/%s\n' "$name" "$session_id" "$tty"
  done < <(jq -r 'select(.name) | "\(.pid)\t\(.name)\t\(.sessionId)"' "$HOME"/.claude/sessions/*.json | sort -t$'\t' -k2,2)
}

tinted_agent_rows() {
  local name session_id tty
  while IFS=$'\t' read -r name session_id tty; do
    printf '\e[%sm%s%s\e[0m\t%s\n' "$(ansi_code_of "$(transcript_color "$session_id")")" "$ROW_MARK" "$name" "$tty"
  done < <(agent_rows)
}

pick_agent() {
  local picked
  picked="$(tinted_agent_rows | fzf --ansi --layout=reverse --no-info --border=rounded --border-label=' Agents ' --delimiter=$'\t' --with-nth=1 --accept-nth=1 \
    --prompt='Agent> ' --header='CTRL-j/k: move | CTRL-u/d: scroll preview | ENTER: focus | ESC: close' \
    --bind='ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down' \
    --preview="$SELF --preview {2}" --preview-window='up:60%:nowrap:follow')" || return 1
  echo "${picked#"$ROW_MARK"}"
}

case "${1:-}" in
  "") open_picker_window ;;
  --pick) agent="$(pick_agent)" && [ -n "$agent" ] && exec "$FOCUS_AGENT" "$agent" ;;
  --preview) screen_of_tty "$2" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' ;;
  *) echo "usage: iterm_agent_picker [--pick | --preview TTY]" >&2; exit 1 ;;
esac
