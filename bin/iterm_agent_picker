#!/usr/bin/env bash
# iterm_agent_picker — an fzf picker over iTerm: live Claude agents, agents that can be woken, or every tab.
# Rows come from bin/iterm_picker_lists; the preview pane shows the row's live screen in color (or a parked
# agent's last words). ctrl+j / ctrl+k move, typing filters, ctrl+u / ctrl+d scroll the preview,
# ctrl+a / ctrl+w / ctrl+t switch to the alive / available (wake) / tabs list, ctrl+x closes the row's tab
# and keeps the picker open, Enter focuses the tab (waking a parked agent first), Esc closes.
#   iterm_agent_picker [alive|available|tabs]   cmd+ctrl+g: open the floating window (the "Agent Picker" profile)
#   iterm_agent_picker --pick LIST              the picker inline, in this terminal (aliases alive-agents, available-agents,
#                                               terminal-tabs); acts on the chosen row itself
#   iterm_agent_picker --pick LIST --into FILE  what runs inside the floating window: writes the chosen row to FILE, the
#                                               launcher acts on it once the window is gone
set -euo pipefail
export PATH="/opt/homebrew/bin:$PATH"

readonly PICKER_PROFILE="Agent Picker"
readonly SELF="$(realpath "${BASH_SOURCE[0]}")"
readonly LISTS="$(dirname "$SELF")/iterm_picker_lists"
readonly TEAMUP_WAKE="$HOME/.claude/skills/suss-teamup/scripts/teamup-wake"
readonly DEFAULT_LIST=alive
readonly PICK_TIMEOUT_SECONDS=300

prompt_of() { case "$1" in alive) echo 'Alive> ' ;; available) echo 'Available> ' ;; tabs) echo 'Tabs> ' ;; esac; }
list_of_prompt() { case "$1" in 'Alive> ') echo alive ;; 'Available> ') echo available ;; 'Tabs> ') echo tabs ;; esac; }
label_of() { case "$1" in alive) echo ' Alive agents ' ;; available) echo ' Available agents (zz = asleep, Enter wakes) ' ;; tabs) echo ' Terminal tabs ' ;; esac; }

switch_binding() { # key list
  printf '%s:reload(%s rows %s)+change-prompt(%s)+change-border-label(%s)' "$1" "$LISTS" "$2" "$(prompt_of "$2")" "$(label_of "$2")"
}

pick_row() { # list — prints `kind<TAB>arg` of the chosen row
  "$LISTS" rows "$1" | fzf --ansi --layout=reverse --no-info --border=rounded --border-label="$(label_of "$1")" \
    --delimiter=$'\t' --with-nth=1 --accept-nth=2,3 --prompt="$(prompt_of "$1")" \
    --header='CTRL-j/k: move | CTRL-u/d: scroll preview | CTRL-a/w/t: alive/available/tabs | CTRL-x: close tab | ENTER: focus | ESC: quit' \
    --bind='ctrl-u:preview-half-page-up,ctrl-d:preview-half-page-down' \
    --bind="$(switch_binding ctrl-a alive)" --bind="$(switch_binding ctrl-w available)" --bind="$(switch_binding ctrl-t tabs)" \
    --bind="ctrl-x:execute-silent($LISTS close {3})+reload($SELF --rows-of-prompt)" \
    --preview="$LISTS preview {2} {3}" --preview-window='up:60%:nowrap:follow'
}

rows_of_prompt() { "$LISTS" rows "$(list_of_prompt "${FZF_PROMPT:-}")"; }

wake_and_focus() { # handle
  "$TEAMUP_WAKE" "$1" >&2 || return 1
  local tty; tty="$("$LISTS" tty-of-agent "$1")"
  [ -n "$tty" ] && "$LISTS" focus "$tty" >/dev/null
}

perform() { # kind arg
  case "$1" in
    focus) "$LISTS" focus "$2" >/dev/null ;;
    wake) wake_and_focus "$2" ;;
  esac
}

pick_and_perform() { # list
  local kind arg
  IFS=$'\t' read -r kind arg < <(pick_row "$1") || return 1
  [ -n "${kind:-}" ] && perform "$kind" "$arg"
}

pick_into() { # list file — the floating window's command: leave the choice for the launcher
  local kind arg
  IFS=$'\t' read -r kind arg < <(pick_row "$1") || return 1
  printf '%s\t%s\n' "$kind" "$arg" > "$2"
}

wait_for_choice() { # file — until the picker wrote it, or gave up (Esc closes the window without writing)
  local waited=0
  while [ ! -s "$1" ] && [ "$waited" -lt "$PICK_TIMEOUT_SECONDS" ]; do
    sleep 0.2; waited=$((waited + 1))
    pgrep -fq -- "--into $1" || break
  done
  [ -s "$1" ]
}

open_picker_window() { # list
  local choice kind arg
  choice="$(mktemp -t agent_picker)"; rm -f "$choice"
  osascript -l JavaScript - "$PICKER_PROFILE" "$SELF --pick $1 --into $choice" <<'JXA'
ObjC.import('AppKit');
const SCREEN_FRACTION = 0.9;
const coverScreenCenter = (window) => {
  const screen = $.NSScreen.mainScreen.frame.size;
  const visible = $.NSScreen.mainScreen.visibleFrame;
  const width = Math.round(visible.size.width * SCREEN_FRACTION);
  const height = Math.round(visible.size.height * SCREEN_FRACTION);
  const visibleTop = screen.height - (visible.origin.y + visible.size.height);
  window.bounds = {
    x: Math.round(visible.origin.x + (visible.size.width - width) / 2),
    y: Math.round(visibleTop + (visible.size.height - height) / 2),
    width,
    height,
  };
};
function run([profile, command]) {
  const iterm = Application('iTerm2');
  const window = iterm.createWindowWithProfile(profile, { command });
  iterm.activate();
  coverScreenCenter(window);
}
JXA
  sleep 1
  wait_for_choice "$choice" || return 0
  IFS=$'\t' read -r kind arg < "$choice"; rm -f "$choice"
  perform "$kind" "$arg"
}

case "${1:-}" in
  ""|alive|available|tabs) open_picker_window "${1:-$DEFAULT_LIST}" ;;
  --pick) if [ "${3:-}" = "--into" ]; then pick_into "$2" "$4"; else pick_and_perform "$2"; fi ;;
  --rows-of-prompt) rows_of_prompt ;;
  --preview) "$LISTS" preview focus "$2" ;;
  *) sed -n '7,12p' "$0" >&2; exit 1 ;;
esac
