#!/usr/bin/env bash
# claude_transcript_jump — fuzzy-find a line of the Claude conversation in the current iTerm tab (like nvim's
# <space>bl), then scroll that tab's Claude view to it and highlight it (bin/iterm_select_rows). Enter scrolls, Esc closes.
# Claude has no search, so the scroll types ctrl+End, then PageUp/PageDown bursts sized from the lines on screen.
#   claude_transcript_jump                          cmd+ctrl+o: the picker in a floating window (bin/iterm_float), then the scroll
#   claude_transcript_jump --pick LINES --into FILE what runs inside the floating window: writes the chosen line number to FILE
#                                                   and exits, so the window closes before the scroll starts
#   claude_transcript_jump --scroll ID LINES NUMBER scroll the Claude tab (ID = its iTerm session) to line NUMBER of LINES, highlight it
set -euo pipefail
export PATH="$HOME/.dotfiles/bin:/opt/homebrew/bin:$PATH"

readonly SELF="$(realpath "${BASH_SOURCE[0]}")"
readonly FLOAT_STARTUP_SECONDS=1

notify() { osascript -e "display notification \"$1\" with title \"claude_transcript_jump\""; }

front_iterm_session() { # prints `session id<TAB>tty`
  osascript -e 'tell application "iTerm2" to tell current session of current window to return (id as text) & (character id 9) & tty'
}

claude_session_on_tty() { # tty — the Claude session id from its ~/.claude/sessions record
  local pid
  for pid in $(ps -t "${1#/dev/}" -o pid=); do
    [ -f "$HOME/.claude/sessions/$pid.json" ] && jq -r .sessionId "$HOME/.claude/sessions/$pid.json" && return
  done
}

conversation_lines() { # transcript.jsonl — the prompts and replies the Claude view shows, one `user|assistant<TAB>line` each
  jq -r 'select(.isSidechain != true and .isMeta != true and (.type == "user" or .type == "assistant"))
    | .type as $role | .message.content | if type == "string" then . else (.[] | select(.type == "text") | .text) end
    | select(startswith("<") | not) | split("\n")[] | select(test("\\S")) | "\($role)\t\(.)"' "$1"
}

colorized() { # conversation lines — in Claude's dark theme: prompts on its gray with ❯, **bold**, `code` in its lavender
  perl -CSD -pe '
    s/^user\t(.*)/\e[48;2;55;55;55m\x{276F} $1\e[0m/;
    s/^assistant\t//;
    s/\*\*(.+?)\*\*/\e[1m$1\e[22m/g;
    s/`([^`]+)`/\e[38;2;177;185;249m$1\e[39m/g;
    s/^#+ (.*)/\e[1m$1\e[22m/;
  ' "$1"
}

wait_for_pick() { # choice file — until the floating picker exits (Esc leaves the file empty)
  sleep "$FLOAT_STARTUP_SECONDS"
  while pgrep -fq -- "--into $1"; do sleep 0.1; done
  [ -s "$1" ]
}

pick_in_floating_window() { # lines — prints the chosen line number
  local choice
  choice="$(mktemp -t claude_transcript_choice)"
  iterm_float --fraction 1 "$SELF --pick $1 --into $choice" && wait_for_pick "$choice" && cat "$choice"
  local outcome=$?
  rm -f "$choice"
  return "$outcome"
}

open_picker() {
  local iterm_session tty claude_session lines number
  IFS=$'\t' read -r iterm_session tty < <(front_iterm_session)
  claude_session="$(claude_session_on_tty "$tty")"
  [ -n "$claude_session" ] || { notify "No Claude session in this tab"; return 0; }
  lines="$(mktemp -t claude_transcript)"
  conversation_lines "$(compgen -G "$HOME/.claude/projects/*/$claude_session.jsonl" | head -1)" > "$lines"
  number="$(pick_in_floating_window "$lines")" || { rm -f "$lines"; return 0; }
  scroll_and_highlight "$iterm_session" "$lines" "$number"
}

pick_line_number() { # lines — the list reads top to bottom like the file, newest next to the prompt
  local display="$1.ansi"
  colorized "$1" > "$display"
  nl -ba -w1 -s$'\t' "$display" | fzf --ansi --tac --layout=default --no-info --border=none \
    --prompt='Claude conversation> ' --header='ENTER: scroll Claude to it | ESC: quit' \
    --delimiter=$'\t' --with-nth=2.. --accept-nth=1 \
    --preview="awk -v chosen={1} 'NR == chosen { printf \"\\033[7m%s\\033[0m\\n\", \$0; next } 1' $display" \
    --preview-window='up:50%:wrap:border-bottom:+{1}/2'
  local outcome=$?
  rm -f "$display"
  return "$outcome"
}

scroll_claude_to() { # iterm session id, lines, line number
  osascript -l JavaScript - "$@" <<'JXA'
ObjC.import('Foundation');
const SCROLL_TO_BOTTOM = '\x1b[1;5F';
const PAGE_UP = '\x1b[5~';
const PAGE_DOWN = '\x1b[6~';
const SETTLE_SECONDS = 0.1;
const SNIPPET_LENGTH = 40;
const LANDMARK_MIN_LENGTH = 15;
const MAX_JUMPS = 40;

const normalized = (text) => text.replace(/[`*_#>|│]/g, '').replace(/\s+/g, ' ').trim();

const readLines = (path) =>
  $.NSString.stringWithContentsOfFileEncodingError(path, $.NSUTF8StringEncoding, null).js.split('\n').map((line) => line.replace(/^[a-z]+\t/, ''));

const sessionWithId = (iterm, id) =>
  iterm.windows().flatMap((window) => window.tabs().flatMap((tab) => tab.sessions())).find((session) => session.id() === id);

const visibleRows = (session) => session.contents().replace(/\n$/, '').split('\n').slice(-session.rows());

const isContinuationOf = (line, row) => normalized(row) !== '' && line.includes(normalized(row));

const rowsShowing = (rows, line) => {
  const first = rows.findIndex((row) => normalized(row).includes(line.slice(0, SNIPPET_LENGTH / 2)));
  let last = first;
  while (last + 1 < rows.length && isContinuationOf(line, rows[last + 1])) last++;
  return `${first} ${last}`;
};

const press = (session, key, times) => {
  session.write({ text: key.repeat(times), newline: false });
  delay(SETTLE_SECONDS);
};

const occursOnce = (snippets, snippet) => snippets.indexOf(snippet) === snippets.lastIndexOf(snippet);

const landmarkIndexes = (snippets) =>
  snippets.map((snippet, idx) => idx).filter((idx) => snippets[idx].length >= LANDMARK_MIN_LENGTH && occursOnce(snippets, snippets[idx]));

const visibleSpan = (screen, snippets, landmarks) => {
  const visible = landmarks.filter((idx) => screen.includes(snippets[idx]));
  return visible.length ? { top: visible[0], bottom: visible[visible.length - 1] } : null;
};

const isTargetOnScreen = ({ screen, span, snippets, target }) =>
  screen.includes(snippets[target]) &&
  (occursOnce(snippets, snippets[target]) || (span !== null && span.top <= target && target <= span.bottom));

const pagesToTarget = (span, target) => {
  const linesPerPage = span.bottom - span.top + 1;
  return target < span.top
    ? -Math.ceil((span.top - target) / linesPerPage)
    : Math.ceil((target - span.bottom) / linesPerPage);
};

function run([id, linesPath, lineNumber]) {
  const session = sessionWithId(Application('iTerm2'), id);
  const lines = readLines(linesPath).map(normalized);
  const snippets = lines.map((line) => line.slice(0, SNIPPET_LENGTH));
  const target = Number(lineNumber) - 1;
  const landmarks = landmarkIndexes(snippets);
  press(session, SCROLL_TO_BOTTOM, 1);
  for (let jump = 0; jump < MAX_JUMPS; jump++) {
    const rows = visibleRows(session);
    const screen = normalized(rows.join('\n'));
    const span = visibleSpan(screen, snippets, landmarks);
    if (isTargetOnScreen({ screen, span, snippets, target })) return `found ${rowsShowing(rows, lines[target])}`;
    const pages = span ? pagesToTarget(span, target) : -1;
    press(session, pages < 0 ? PAGE_UP : PAGE_DOWN, Math.max(1, Math.abs(pages)));
  }
  return `gave up after ${MAX_JUMPS} jumps`;
}
JXA
}

scroll_and_highlight() { # iterm session id, lines, line number
  local outcome first_row last_row
  echo "scrolling Claude to line $3: $(sed -n "${3}p" "$2")"
  read -r outcome first_row last_row < <(scroll_claude_to "$@")
  rm -f "$2"
  [ "$outcome" = found ] || { echo "not found: $outcome $first_row $last_row"; return 0; }
  [ "$first_row" -ge 0 ] || { echo "on screen, but no single row holds its start: not highlighted"; return 0; }
  iterm_select_rows "$1" "$first_row" "$last_row"
}

pick_into() { # lines, choice file
  local number
  number="$(pick_line_number "$1")" || return 0
  echo "$number" > "$2"
}

case "${1:-}" in
  "") open_picker ;;
  --pick) pick_into "$2" "$4" ;;
  --scroll) scroll_and_highlight "$2" "$3" "$4" ;;
  *) sed -n '5,9p' "$0" >&2; exit 1 ;;
esac
