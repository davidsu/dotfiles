#!/usr/bin/env bash
# claude_transcript_jump — fuzzy-find a line of the Claude conversation in the current iTerm tab (like nvim's
# <space>bl), then scroll that tab's Claude view to it (bin/claude_scroll_to_line) and highlight it (bin/iterm_select_rows).
# The list starts on your prompts (one row per prompt); ctrl+w switches between them and every line of the chat.
# The preview is Claude's own rendering of the chat (bin/claude_view_export, what ctrl+o then v writes), made while the
# floating window opens; without it, the preview falls back to the conversation lines in Claude's colors.
#   claude_transcript_jump                          cmd+ctrl+o: the picker in a floating window (bin/iterm_float), then the scroll
#   claude_transcript_jump --pick LINES --into FILE what runs inside the floating window: writes the chosen line number to FILE
#                                                   and exits, so the window closes before the scroll starts
#   claude_transcript_jump --scroll ID LINES NUMBER scroll the Claude tab (ID = its iTerm session) to line NUMBER of LINES, highlight it
#   claude_transcript_jump --rows prompts|all LINES the picker's rows: `preview row<TAB>line number<TAB>text`
set -euo pipefail
export PATH="$HOME/.dotfiles/bin:/opt/homebrew/bin:$PATH"

readonly SELF="$(realpath "${BASH_SOURCE[0]}")"
readonly FLOAT_STARTUP_SECONDS=1
readonly PREVIEW_WAIT_TENTHS=100
readonly CURSOR_LINE_BACKGROUND=$'\e[48;2;58;64;76m'
declare -rx PROMPT_BACKGROUND=$'\e[48;2;55;55;55m'
readonly PROMPTS_PROMPT='Your prompts> '
readonly ALL_PROMPT='Whole chat> '

notify() { osascript -e "display notification \"$1\" with title \"claude_transcript_jump\""; }

front_iterm_session() { # prints `session id<TAB>tty`
  osascript -e 'tell application "iTerm2" to tell current session of current window to return (id as text) & (character id 9) & tty'
}

claude_session_on_tty() { # tty — the Claude session id from its ~/.claude/sessions record
  local pid
  for pid in $(ps -t "${1#/dev/}" -o pid=); do
    [ -f "$HOME/.claude/sessions/$pid.json" ] && jq -r .sessionId "$HOME/.claude/sessions/$pid.json" && return
  done
}

conversation_lines() { # transcript.jsonl — the prompts (typed or queued mid-reply) and replies on screen (the path from the last entry back through its parents), one `user|assistant<TAB>message<TAB>line` each
  jq -rs 'map(select(.uuid != null)) | INDEX(.uuid) as $by_id
    | [last(.[] | select(.uuid != null)) | recurse($by_id[.parentUuid // .logicalParentUuid // ""] // empty)] | reverse
    | to_entries[] | .key as $message | .value
    | select(.isSidechain != true and .isMeta != true)
    | if .type == "attachment" and .attachment.type == "queued_command" then {role: "user", content: .attachment.prompt}
      elif .type == "user" or .type == "assistant" then {role: .type, content: .message.content}
      else empty end
    | .role as $role | .content | if type == "string" then . else (.[]? | select(.type == "text") | .text) end
    | select(startswith("<") or startswith("[Request interrupted") | not) | split("\n")[] | select(test("\\S")) | "\($role)\t\($message)\t\(.)"' "$1"
}

colorized() { # conversation lines — in Claude's dark theme: prompts on its gray with ❯, **bold**, `code` in its lavender
  perl -CSD -pe '
    s/^user\t\d+\t(.*)/$ENV{PROMPT_BACKGROUND}\x{276F} $1\e[0m/;
    s/^assistant\t\d+\t//;
    s/\*\*(.+?)\*\*/\e[1m$1\e[22m/g;
    s/`([^`]+)`/\e[38;2;177;185;249m$1\e[39m/g;
    s/^#+ (.*)/\e[1m$1\e[22m/;
  ' "$1"
}

shaded_prompts() { # Claude's export — your prompts on Claude's gray, as on screen
  awk -v shade="$PROMPT_BACKGROUND" '
    index($0, "❯ ") == 1 { in_prompt = 1 }
    /^[[:space:]]*$/ { in_prompt = 0 }
    { print (in_prompt ? shade $0 "\033[0m" : $0) }' "$1"
}

export_rows_of_lines() { # lines, Claude's export — for each line, the export row it starts on (in order; unmatched keep the last)
  python3 -I - "$1" "$2" <<'PY'
import re
import sys

SNIPPET_LENGTH = 30
LOOKAHEAD_ROWS = 400


def normalized(text):
    return re.sub(r"\s+", " ", re.sub(r"[`*_#>|│⏺❯]", "", text)).strip()


lines_path, export_path = sys.argv[1:3]
snippets = [normalized(line.split("\t", 2)[2])[:SNIPPET_LENGTH] for line in open(lines_path, encoding="utf-8").read().splitlines()]
rows = [normalized(row) for row in open(export_path, encoding="utf-8").read().splitlines()]
row = 0
for snippet in snippets:
    row = next((idx for idx in range(row, min(len(rows), row + LOOKAHEAD_ROWS)) if snippet in rows[idx]), row)
    print(row + 1)
PY
}

prepare_preview() { # iterm session id, lines — writes LINES.view (what the preview shows), then LINES.map (each line's row in it)
  local export
  export="$(claude_view_export "$1")"
  if [ -n "$export" ]; then
    shaded_prompts "$export" > "$2.view"
    export_rows_of_lines "$2" "$export" > "$2.map.tmp"
    rm -f "$export"
  else
    colorized "$2" > "$2.view"
    seq "$(wc -l < "$2")" > "$2.map.tmp"
  fi
  mv "$2.map.tmp" "$2.map"
}

preview_with_cursor_line() { # preview file, chosen row — the chosen row on a full-width band, like nvim's CursorLine
  awk -v chosen="$2" -v band="$CURSOR_LINE_BACKGROUND" -v prompt_band="$PROMPT_BACKGROUND" -v width="${FZF_PREVIEW_COLUMNS:-80}" '
    function replace_all(text, from, to,    at, result) {
      while ((at = index(text, from)) > 0) { result = result substr(text, 1, at - 1) to; text = substr(text, at + length(from)) }
      return result text
    }
    NR != chosen { print; next }
    {
      line = replace_all(replace_all($0, "\033[0m", "\033[0m" band), prompt_band, band)
      plain = $0
      gsub(/\033\[[0-9;]*m/, "", plain)
      padding = width > length(plain) ? sprintf("%" (width - length(plain)) "s", "") : ""
      printf "%s%s%s\033[0m\n", band, line, padding
    }' "$1"
}

wait_for_pick() { # choice file — until the floating picker exits (Esc leaves the file empty)
  sleep "$FLOAT_STARTUP_SECONDS"
  while pgrep -fq -- "--into $1"; do sleep 0.1; done
  [ -s "$1" ]
}

pick_in_floating_window() { # lines — prints the chosen line number
  local choice
  choice="$(mktemp -t claude_transcript_choice)"
  iterm_float --fraction 1 "$SELF --pick $1 --into $choice" && wait_for_pick "$choice" && cat "$choice"
  local outcome=$?
  rm -f "$choice"
  return "$outcome"
}

open_picker() {
  local iterm_session tty claude_session lines number
  IFS=$'\t' read -r iterm_session tty < <(front_iterm_session)
  claude_session="$(claude_session_on_tty "$tty")"
  [ -n "$claude_session" ] || { notify "No Claude session in this tab"; return 0; }
  lines="$(mktemp -t claude_transcript)"
  trap "wait; rm -f '$lines' '$lines.view' '$lines.map'" EXIT
  conversation_lines "$(compgen -G "$HOME/.claude/projects/*/$claude_session.jsonl" | head -1)" > "$lines"
  prepare_preview "$iterm_session" "$lines" &
  number="$(pick_in_floating_window "$lines")" || return 0
  scroll_and_highlight "$iterm_session" "$lines" "$number"
}

prompt_rows() { # lines — one row per prompt: its first line, its lines joined
  awk -F'\t' '
    NR == FNR { row[FNR] = $1; next }
    function print_prompt() { if (in_prompt) print row[first] "\t" first "\t" text; in_prompt = 0 }
    $1 == "user" && in_prompt && $2 == message { text = text " " $3; next }
    $1 == "user" { print_prompt(); in_prompt = 1; message = $2; first = FNR; text = $3; next }
    { print_prompt() }
    END { print_prompt() }' "$1.map" "$1"
}

all_rows() { # lines
  awk 'NR == FNR { row[FNR] = $0; next } { text = $0; sub(/^[^\t]*\t[^\t]*\t/, "", text); print row[FNR] "\t" FNR "\t" text }' "$1.map" "$1"
}

switch_rows_binding() { # lines — ctrl+w flips between your prompts and the whole chat
  printf 'ctrl-w:transform:[ "$FZF_PROMPT" = %q ] && echo %q || echo %q' "$PROMPTS_PROMPT" \
    "reload($SELF --rows all $1)+change-prompt($ALL_PROMPT)" "reload($SELF --rows prompts $1)+change-prompt($PROMPTS_PROMPT)"
}

wait_for_preview() { # lines
  local attempt
  for attempt in $(seq "$PREVIEW_WAIT_TENTHS"); do [ -f "$1.map" ] && return 0; sleep 0.1; done
  return 1
}

pick_line_number() { # lines — plain list in file order under the prompt, starting on the newest row; the preview above
  wait_for_preview "$1" || return 1
  prompt_rows "$1" | fzf --layout=reverse --no-info --border=none --wrap-sign='  ' \
    --prompt="$PROMPTS_PROMPT" --header='ENTER: scroll Claude to it | CTRL-W: your prompts / whole chat | ESC: quit' \
    --delimiter=$'\t' --with-nth=3.. --accept-nth=2 --bind='load:last' --bind='change:first' --bind="$(switch_rows_binding "$1")" \
    --preview="$SELF --preview $1.view {1}" \
    --preview-window='up:65%:wrap:border-bottom:+{1}-2'
}

scroll_and_highlight() { # iterm session id, lines, line number
  local outcome first_row last_row
  echo "scrolling Claude to line $3: $(sed -n "${3}p" "$2")"
  read -r outcome first_row last_row < <(claude_scroll_to_line "$@")
  [ "$outcome" = found ] || { echo "not found: $outcome $first_row $last_row"; return 0; }
  [ "$first_row" -ge 0 ] || { echo "on screen, but no single row holds its start: not highlighted"; return 0; }
  iterm_select_rows "$1" "$first_row" "$last_row"
}

pick_into() { # lines, choice file
  local number
  number="$(pick_line_number "$1")" || return 0
  echo "$number" > "$2"
}

case "${1:-}" in
  "") open_picker ;;
  --pick) pick_into "$2" "$4" ;;
  --preview) preview_with_cursor_line "$2" "$3" ;;
  --rows) if [ "$2" = prompts ]; then prompt_rows "$3"; else all_rows "$3"; fi ;;
  --scroll) scroll_and_highlight "$2" "$3" "$4" ;;
  *) sed -n '7,11p' "$0" >&2; exit 1 ;;
esac
