#!/usr/bin/osascript -l JavaScript
// claude_session_style — name and color the Claude Code or Codex session in the current iTerm tab.
// One dialog: type a name, ↑/↓ cycles /color's palette (starts on a random pick), Enter applies.
// The name field starts on the session's current user-chosen name, so Enter alone recolors.
// An empty or unchanged name applies only the color. Types /rename and /color into the tab (focus-free).
// Only acts on an idle Claude tab ("✳ … (claude)") or an idle Codex tab ("… (codex)", no spinner):
// a busy TUI drops input. Both get the iTerm tab color via iterm_tab_style; claude also gets /color.
ObjC.import('Cocoa');

const SESSION_COLORS = ['red', 'blue', 'green', 'yellow', 'purple', 'orange', 'pink', 'cyan'];
const KEYSTROKE_GAP_SECONDS = 0.1;
const CLEAR_LINE = '\x15';
const ARROW_STEPS = { 'moveUp:': -1, 'moveDown:': 1 };

const swatchFor = (color) => ({
  red: $.NSColor.systemRedColor,
  blue: $.NSColor.systemBlueColor,
  green: $.NSColor.systemGreenColor,
  yellow: $.NSColor.systemYellowColor,
  purple: $.NSColor.systemPurpleColor,
  orange: $.NSColor.systemOrangeColor,
  pink: $.NSColor.systemPinkColor,
  cyan: $.NSColor.systemCyanColor,
})[color];

const isIdleClaude = (session) => {
  const title = session.name();
  return title.startsWith('✳') && title.endsWith('(claude)');
};

const CODEX_BUSY_SPINNER = /^[\u2800-\u28FF]/;
const CODEX_SUBMIT_DELAY_SECONDS = 1.5;
const TAB_STYLE = `${$.NSHomeDirectory().js}/.dotfiles/bin/iterm_tab_style`;

const SESSIONS_DIR = `${$.NSHomeDirectory().js}/.claude/sessions`;

const shell = (command) => {
  const app = Application.currentApplication();
  app.includeStandardAdditions = true;
  return app.doShellScript(command);
};

const pidsOnTty = (session) => shell(`ps -t '${session.tty().replace('/dev/', '')}' -o pid=`).split(/\s+/).filter(Boolean);

const readSessionRecord = (pid) => {
  const contents = $.NSString.stringWithContentsOfFileEncodingError(`${SESSIONS_DIR}/${pid}.json`, $.NSUTF8StringEncoding, null);
  return contents.isNil() ? null : JSON.parse(contents.js);
};

const userChosenName = (record) => (record && record.nameSource !== 'derived' && record.name) || '';

const currentSessionName = (session) =>
  pidsOnTty(session).map(readSessionRecord).map(userChosenName).find(Boolean) || '';

const isIdleCodex = (session) => {
  const title = session.name();
  return title.endsWith('(codex)') && !CODEX_BUSY_SPINNER.test(title);
};

const showAlert = (message, info) => {
  const alert = $.NSAlert.alloc.init;
  alert.messageText = message;
  alert.informativeText = info;
  return alert;
};

const createColorPicker = () => {
  const picker = { index: Math.floor(Math.random() * SESSION_COLORS.length) };
  picker.swatch = $.NSTextField.labelWithString('');
  picker.swatch.frame = $.NSMakeRect(0, 0, 300, 22);
  picker.swatch.drawsBackground = true;
  picker.swatch.alignment = $.NSTextAlignmentCenter;
  picker.color = () => SESSION_COLORS[picker.index];
  picker.paint = () => {
    picker.swatch.stringValue = `↑  ${picker.color()}  ↓`;
    picker.swatch.backgroundColor = swatchFor(picker.color());
  };
  picker.step = (offset) => {
    picker.index = (picker.index + offset + SESSION_COLORS.length) % SESSION_COLORS.length;
    picker.paint();
  };
  picker.paint();
  return picker;
};

const registerArrowDelegate = (picker) => {
  ObjC.registerSubclass({
    name: 'ClaudeSessionColorCycler',
    protocols: ['NSTextFieldDelegate'],
    methods: {
      'control:textView:doCommandBySelector:': {
        types: ['bool', ['id', 'id', 'SEL']],
        implementation: (control, textView, selector) => {
          const offset = ARROW_STEPS[selector];
          if (!offset) return false;
          picker.step(offset);
          return true;
        },
      },
    },
  });
  return $.ClaudeSessionColorCycler.alloc.init;
};

const buildStyleDialog = (currentName) => {
  const picker = createColorPicker();
  const nameField = $.NSTextField.alloc.initWithFrame($.NSMakeRect(0, 30, 300, 24));
  nameField.stringValue = currentName;
  nameField.placeholderString = 'session name (empty = color only)';
  nameField.delegate = registerArrowDelegate(picker);
  const accessory = $.NSView.alloc.initWithFrame($.NSMakeRect(0, 0, 300, 54));
  accessory.addSubview(nameField);
  accessory.addSubview(picker.swatch);
  const alert = showAlert('Name Claude session', '↑/↓ changes the color');
  alert.addButtonWithTitle('OK');
  alert.addButtonWithTitle('Cancel');
  alert.accessoryView = accessory;
  alert.layout;
  alert.window.initialFirstResponder = nameField;
  return { alert, nameField, picker };
};

const promptStyle = (currentName) => {
  const { alert, nameField, picker } = buildStyleDialog(currentName);
  $.NSApplication.sharedApplication.activateIgnoringOtherApps(true);
  if (alert.runModal !== $.NSAlertFirstButtonReturn) return null;
  const name = nameField.stringValue.js.trim();
  return { name: name === currentName ? '' : name, color: picker.color() };
};

const typeSlashCommand = (session, slashCommand) => {
  [CLEAR_LINE, slashCommand, ''].forEach((text, idx, chunks) => {
    session.write({ text, newline: idx === chunks.length - 1 });
    delay(KEYSTROKE_GAP_SECONDS);
  });
};

const typeCodexCommand = (session, command) => {
  session.write({ text: CLEAR_LINE, newline: false });
  delay(KEYSTROKE_GAP_SECONDS);
  session.write({ text: command, newline: false });
  delay(CODEX_SUBMIT_DELAY_SECONDS);
  session.write({ text: '', newline: true });
};

const colorTab = (session, color) => shell(`'${TAB_STYLE}' --tty '${session.tty()}' --color ${color}`);

const styleClaude = (session, style) => {
  colorTab(session, style.color);
  if (style.name) typeSlashCommand(session, `/rename ${style.name}`);
  typeSlashCommand(session, `/color ${style.color}`);
};

const styleCodex = (session, style) => {
  colorTab(session, style.color);
  if (style.name) typeCodexCommand(session, `/rename ${style.name}`);
};

function run() {
  $.NSApplication.sharedApplication.setActivationPolicy($.NSApplicationActivationPolicyAccessory);
  const iterm = Application('iTerm2');
  const target = iterm.currentWindow().currentSession();
  console.log(`${new Date().toISOString()} invoked on ${JSON.stringify(target.name())}`);
  const applyStyle = isIdleClaude(target) ? styleClaude : isIdleCodex(target) ? styleCodex : null;
  if (!applyStyle) {
    showAlert('Not an idle Claude or Codex session', 'Focus an agent tab that is waiting at its prompt.').runModal;
    return;
  }
  const style = promptStyle(currentSessionName(target));
  iterm.activate();
  if (!style) return;
  applyStyle(target, style);
}
