#!/bin/zsh

# Shortcut to dotfiles directory
export DOTFILES="$HOME/.dotfiles"

# reload zsh configuration
function reload() {
    # Source all .zsh files in the sources directory and subdirectories
    for f in "$DOTFILES"/zsh/sources/**/*.zsh(N); do
        source "$f"
    done
}

# Initial load
reload

# Alias for manual reload
alias a='reload'

[ -f "$HOME/projects/work.sh" ] && source "$HOME/projects/work.sh"

# >>> b44 mcp-secrets (managed by b44) >>>
if [ -f "$HOME/.b44/groups/mcp/.env" ]; then
  set -a; . "$HOME/.b44/groups/mcp/.env"; set +a   # auto-export so child processes (e.g. Claude Code) inherit the vars
fi
# <<< b44 mcp-secrets <<<
