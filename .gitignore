# ~/.config is a symlink to config.ln, so every app drops its runtime state and
# credentials here. All of it is ignored; to track a new tool, add a ! line below.
config.ln/*
!config.ln/ccstatusline/
!config.ln/gh/
!config.ln/ghostty/
!config.ln/git/
!config.ln/hammerspoon.ln/
!config.ln/karabiner/
!config.ln/kitty/
!config.ln/linearmouse/
!config.ln/mise/
!config.ln/nvim/
!config.ln/prettierrc.ln.json
!config.ln/qmk/
!config.ln/ripgrep/
!config.ln/starship.toml
!config.ln/tmux.ln.conf
!config.ln/tsconfig.ln.json
